; Nucleus replacement compiler state and internal token authority.
;
; The deployment composition supplies CompilerWorkBase, SourceBase, and
; SourceLimit. Every pointer remains a complete sixteen-bit address.

RewriteStateBase              .equ CompilerWorkBase
; R1 diagnostics publish part and byte offset. The test-selected Host image
; derives line and byte column from the retained source. A later parser may
; remove this marker when oracle parity requires an independent token anchor.
RewriteDiagnosticOffsetsOnly  .equ 1

; The first five bytes mirror a source descriptor, allowing an exact LDIR.
SourcePartId                 .equ RewriteStateBase+$00
RewriteSourceDescriptorStart .equ RewriteStateBase+$01 ; word
RewriteSourceEnd             .equ RewriteStateBase+$03 ; word
; The live position block is contiguous for the token-start snapshot. The Z80
; compiler owns part and byte offset; the host derives line and byte column from
; the original retained source, exactly as the D8 collector does.
RewriteSourceOffset          .equ RewriteStateBase+$05 ; word
RewriteSourceCursor          .equ RewriteStateBase+$07 ; word
RewriteSourcePartsRemaining  .equ RewriteStateBase+$09
RewriteSourceNextDescriptor  .equ RewriteStateBase+$0A ; word
; The low seven bits are the remaining-part count (0..7). Bit 7 means that a
; synthesized newline has been returned and the next token request must load
; the following part. This is bounded parser state, never address metadata.
RewriteSourceAdvancePendingBit .equ 7
RewriteSourceLineHasToken    .equ RewriteStateBase+$0C
RewriteSourceDelimiterDepth  .equ RewriteStateBase+$0D

; The tokenizer returns kind in A and payload in BC. TokenKind and TokenValue
; are consumer-owned lookahead slots; the tokenizer does not write them.
; TokenLength retains a NAME length or decoded string length, while
; TokenLexemePointer points into the retained source. Other token kinds leave
; TokenLength unspecified.
TokenKind                    .equ RewriteStateBase+$0E
TokenValue                   .equ RewriteStateBase+$0F ; word
TokenPartId                  .equ RewriteStateBase+$11
TokenStartOffset             .equ RewriteStateBase+$12 ; word
TokenLexemePointer           .equ RewriteStateBase+$14 ; word
TokenLength                  .equ RewriteStateBase+$16
RewriteTokenRecordSize       .equ 9

DiagnosticCode               .equ RewriteStateBase+$17
DiagnosticPartId             .equ RewriteStateBase+$18
DiagnosticOffset             .equ RewriteStateBase+$19 ; word
CompilerAbortSp              .equ RewriteStateBase+$1B ; word

; Host API 1 initializes these fields before entering either compiler image.
; R1 returns a diagnostic before target publication, so the adapter capture
; fields are reserved only to keep the internal image-selection seam exact.
AdapterCursor                .equ RewriteStateBase+$1D ; word
AdapterOpen                  .equ RewriteStateBase+$1F
AdapterCommitted             .equ RewriteStateBase+$20
AdapterAborted               .equ RewriteStateBase+$21
AdapterFailureCountdown      .equ RewriteStateBase+$22
AdapterMapFailure            .equ RewriteStateBase+$23
AdapterCommitFailure         .equ RewriteStateBase+$24
AdapterCapturedMap           .equ RewriteStateBase+$25
AdapterCapturedContext       .equ AdapterCapturedMap+$28
; Delimiter kinds are retained separately from their depth. Each byte is the
; complete left-delimiter token ordinal, so matching never depends on an
; address bit or on the compiler's origin. Depth 255 is the published limit.
RewriteDelimiterStack        .equ AdapterCapturedContext+$12
RewriteDelimiterCapacity     .equ 255
; The transcript retains the published 511-byte payload and one operation-
; count byte. Producers stage the largest fixed record's operands before an
; atomic append, so a capacity failure never leaves a partial operation.
RewriteSemanticBufferBase    .equ RewriteDelimiterStack+RewriteDelimiterCapacity
RewriteSemanticPayloadBase   .equ RewriteSemanticBufferBase+1
RewriteSemanticBufferLimit   .equ RewriteSemanticBufferBase+$200
RewriteSemanticSinkCursor    .equ RewriteSemanticBufferLimit ; word
RewriteSemanticReadCursor    .equ RewriteSemanticSinkCursor+2 ; word
RewriteSemanticReadRemaining .equ RewriteSemanticReadCursor+2
RewriteSemanticPendingOperation .equ RewriteSemanticReadRemaining+1
RewriteSemanticPendingOperands .equ RewriteSemanticPendingOperation+1 ; word
RewriteSemanticOperandArea   .equ RewriteSemanticPendingOperands+2
RewriteSemanticOperandCapacity .equ 9
RewriteSemanticOperandLimit  .equ RewriteSemanticOperandArea+RewriteSemanticOperandCapacity

; R3 type metadata. Primitive identities are self-describing. Owned composite
; identities index eight four-byte descriptors and a parallel full-word
; extent. The open-view encodings below are type metadata, never pointers; no
; source or compiler address sacrifices a bit.
RewriteScalarTypeExact       .equ $00
RewriteScalarTypeU8          .equ $01
RewriteScalarTypeU16         .equ $02
RewriteScalarTypeBoolean     .equ $10
RewriteScalarTypeI8          .equ $11
RewriteScalarTypeI16         .equ $12
RewriteScalarTypeBaseMask    .equ $03
RewriteScalarTypeSignedFlag  .equ $10
RewriteTypeMetaNegative      .equ $20
RewriteTypeIdentityMask      .equ $DF
RewriteFirstOwnedTypeId      .equ $40
RewriteOwnedTypeCapacity     .equ 8
RewriteOwnedTypeLimitId      .equ RewriteFirstOwnedTypeId+RewriteOwnedTypeCapacity
RewriteOpenStringTypeId      .equ $7C
RewriteOpenArrayFlag         .equ $80
RewriteOpenArrayElementMask  .equ $7F

RewriteTypeKindRecord        .equ 4
RewriteTypeKindString        .equ 5
RewriteTypeKindArray         .equ 6
RewriteTypeDescriptorSize    .equ 4
RewriteTypeKindOffset        .equ 0
RewriteTypeAuxOffset         .equ 1
RewriteTypeCountOffset       .equ 2 ; word

; Counts and cursors form one reset prefix. Tables need not be cleared because
; every lookup is bounded by its corresponding committed count.
RewriteMetadataControlBase   .equ RewriteSemanticOperandLimit
RewriteTypeCount             .equ RewriteMetadataControlBase+$00
RewriteSymbolCount           .equ RewriteMetadataControlBase+$01
RewriteRecordCount           .equ RewriteMetadataControlBase+$02
RewriteCurrentRecord         .equ RewriteMetadataControlBase+$03
RewriteFieldCount            .equ RewriteMetadataControlBase+$04
RewriteRoutineCount          .equ RewriteMetadataControlBase+$05
RewriteCurrentRoutine        .equ RewriteMetadataControlBase+$06
RewriteParameterCount        .equ RewriteMetadataControlBase+$07
RewriteSymbolScopeBase       .equ RewriteMetadataControlBase+$08
RewriteSuffixCount           .equ RewriteMetadataControlBase+$09
RewriteSuffixOpen            .equ RewriteMetadataControlBase+$0A
RewriteStaticInitializedLength .equ RewriteMetadataControlBase+$0B ; word
RewriteStaticBssLength       .equ RewriteMetadataControlBase+$0D ; word
RewriteStaticConstantLength  .equ RewriteMetadataControlBase+$0F ; word
RewriteMainFlags             .equ RewriteMetadataControlBase+$11
RewriteMainSeen              .equ RewriteMainFlags
RewriteForwardParameterCursor .equ RewriteMetadataControlBase+$12
RewriteForwardParameterRemaining .equ RewriteMetadataControlBase+$13
RewriteForwardParameterType  .equ RewriteMetadataControlBase+$14
RewriteRoutineLookupCursor   .equ RewriteMetadataControlBase+$15
RewriteRoutineLookupRemaining .equ RewriteMetadataControlBase+$16
RewritePendingRoutineFlags   .equ RewriteMetadataControlBase+$17
RewriteCurrentLocalOffset    .equ RewriteMetadataControlBase+$18
RewritePendingParameterType  .equ RewriteMetadataControlBase+$19
RewriteInitializerLength     .equ RewriteMetadataControlBase+$1A ; word
RewriteParserHasToken        .equ RewriteMetadataControlBase+$1C
RewriteActionCursor          .equ RewriteMetadataControlBase+$1D ; word
; The constant evaluator is the first mode of the shared precedence engine.
; Operand values and source offsets are words so no source position or exact
; integer carrier is narrowed. The recursive engine uses the hardware stack;
; this block is only the completed left/right reduction state.
RewriteExpressionExpectedType .equ RewriteMetadataControlBase+$1F
RewriteExpressionDepth        .equ RewriteMetadataControlBase+$20
RewriteExpressionSuppressFault .equ RewriteMetadataControlBase+$21
RewriteExpressionLeftMeta     .equ RewriteMetadataControlBase+$22
RewriteExpressionLeftValue    .equ RewriteMetadataControlBase+$23 ; word
RewriteExpressionLeftOffset   .equ RewriteMetadataControlBase+$25 ; word
RewriteExpressionRightMeta    .equ RewriteMetadataControlBase+$27
RewriteExpressionRightValue   .equ RewriteMetadataControlBase+$28 ; word
RewriteExpressionRightOffset  .equ RewriteMetadataControlBase+$2A ; word
RewriteExpressionOperator     .equ RewriteMetadataControlBase+$2C
RewriteExpressionOperatorOffset .equ RewriteMetadataControlBase+$2D ; word
RewriteCurrentType            .equ RewriteMetadataControlBase+$2F
RewriteDeclarationAnchor      .equ RewriteMetadataControlBase+$30 ; word
; Record construction and assertion evaluation are disjoint top-level phases.
RewriteCurrentRecordExtent    .equ RewriteDeclarationAnchor ; word overlay
RewriteExpressionAtomOffset   .equ RewriteMetadataControlBase+$32 ; word
RewriteInitializerDepth       .equ RewriteMetadataControlBase+$34
; Runtime mode shares the constant precedence parser. Known distinguishes a
; compile-time value carried in HL from a dynamic 16-bit target carrier.
RewriteExpressionMode         .equ RewriteMetadataControlBase+$35
RewriteExpressionKnown        .equ RewriteMetadataControlBase+$36
RewriteExpressionLeftKnown    .equ RewriteMetadataControlBase+$37
RewriteExpressionRightKnown   .equ RewriteMetadataControlBase+$38
RewriteExpressionResolvedType .equ RewriteMetadataControlBase+$39
; A postfix path runs inside one primary before that primary is published as
; the enclosing left operand. Its current type/count/source state therefore
; overlays the otherwise-dead left-reduction slots. Recursive index parsing
; saves and restores the path state on the hardware stack. Types and offsets
; remain full-width metadata; no address bit is borrowed.
RewritePathType                .equ RewriteExpressionLeftMeta
RewritePathCountOffset         .equ RewriteExpressionLeftKnown
RewritePathSourceOffset        .equ RewriteExpressionLeftOffset ; word
; Runtime calls retain only the state that must survive recursive argument
; expressions. The pending failure pointer addresses a declared semantic
; operand in the transcript; it is a complete word and makes no assumption
; about compiler placement. CurrentRoutineFlags is the source routine effect,
; including the separately represented main bit.
RewriteCallDepth               .equ RewriteMetadataControlBase+$3A
RewritePendingFailure          .equ RewriteMetadataControlBase+$3B
RewritePendingCallModePointer  .equ RewriteMetadataControlBase+$3C ; word
RewriteCurrentRoutineFlags     .equ RewriteMetadataControlBase+$3E
RewriteExpressionAggregateCountOffset .equ RewriteMetadataControlBase+$3F
RewritePendingFailureOffset    .equ RewriteMetadataControlBase+$40 ; word
; The active routine summary is independent of directory representation so
; main and ordinary/forward bodies use one statement contract.
RewriteCurrentRoutineResultType .equ RewriteMetadataControlBase+$42
RewriteControlSequenceFallsThrough .equ RewriteMetadataControlBase+$43
RewriteControlDepth            .equ RewriteMetadataControlBase+$44
RewriteControlNextLabel        .equ RewriteMetadataControlBase+$45
RewriteControlPendingCounter   .equ RewriteMetadataControlBase+$46
RewriteControlPendingType      .equ RewriteMetadataControlBase+$47
RewriteControlPendingMode      .equ RewriteMetadataControlBase+$48
RewriteControlPendingStep      .equ RewriteMetadataControlBase+$49 ; word
RewriteControlPendingSourceOffset .equ RewriteMetadataControlBase+$4B ; word
RewriteMetadataControlLimit   .equ RewriteMetadataControlBase+$4D
RewriteExpressionDepthCapacity .equ 16
RewriteInitializerDepthCapacity .equ 4
RewriteCallFrameCapacity       .equ 4

RewriteTypeCandidate         .equ RewriteMetadataControlLimit
RewriteTypeCandidateKind     .equ RewriteTypeCandidate+RewriteTypeKindOffset
RewriteTypeCandidateAux      .equ RewriteTypeCandidate+RewriteTypeAuxOffset
RewriteTypeCandidateCount    .equ RewriteTypeCandidate+RewriteTypeCountOffset ; word
RewriteTypeCandidateExtent   .equ RewriteTypeCandidate+RewriteTypeDescriptorSize ; word
RewriteTypeTableBase         .equ RewriteTypeCandidateExtent+2
RewriteTypeTableLimit        .equ RewriteTypeTableBase+RewriteTypeDescriptorSize*RewriteOwnedTypeCapacity
RewriteTypeExtentBase        .equ RewriteTypeTableLimit
RewriteTypeExtentLimit       .equ RewriteTypeExtentBase+2*RewriteOwnedTypeCapacity

; R3 symbols retain exact source spelling by full pointer and length. The
; provisional entry at RewriteSymbolCount is invisible until commit, keeping
; failed initializers from publishing a declaration.
RewriteSymbolEntrySize       .equ 8
RewriteSymbolCapacity        .equ 16
RewriteSymbolNamePointer     .equ 0 ; word
RewriteSymbolNameLength      .equ 2
RewriteSymbolClass           .equ 3
RewriteSymbolType            .equ 4 ; type identity plus constant metadata
RewriteSymbolPayload         .equ 5 ; word
RewriteSymbolStorage         .equ 7
RewriteSymbolClassConstant   .equ 0
RewriteSymbolClassProgram    .equ 1
RewriteSymbolClassLocal      .equ 2
RewriteSymbolClassParameter  .equ 3
RewriteSymbolClassRecordType .equ 4
RewriteSymbolClassRoutine    .equ 5
RewriteSymbolStorageNone        .equ 0
RewriteSymbolStorageInitialized .equ 1
RewriteSymbolStorageBss         .equ 2
RewriteSymbolStorageReadOnly    .equ 3
RewriteSymbolStorageActivation  .equ 4
RewriteSymbolTableBase       .equ RewriteTypeExtentLimit
RewriteSymbolTableLimit      .equ RewriteSymbolTableBase+RewriteSymbolEntrySize*RewriteSymbolCapacity
RewriteSymbolCompareEntry    .equ RewriteSymbolTableLimit ; word

; Record layouts and fields are separate from the shared source-name table.
RewriteRecordEntrySize       .equ 2
RewriteRecordCapacity        .equ 5
RewriteRecordFieldStart      .equ 0
RewriteRecordFieldCount      .equ 1
RewriteRecordTableBase       .equ RewriteSymbolCompareEntry+2
RewriteRecordTableLimit      .equ RewriteRecordTableBase+RewriteRecordEntrySize*RewriteRecordCapacity

RewriteFieldEntrySize        .equ 6
RewriteFieldCapacity         .equ 12
RewriteFieldNamePointer      .equ 0 ; word
RewriteFieldNameLength       .equ 2
RewriteFieldType             .equ 3
RewriteFieldOffset           .equ 4 ; word
RewriteFieldTableBase        .equ RewriteRecordTableLimit
RewriteFieldTableLimit       .equ RewriteFieldTableBase+RewriteFieldEntrySize*RewriteFieldCapacity

; Routine and retained-parameter directories survive scope rewinds. Main is
; not charged against the four non-main routine entries.
RewriteRoutineEntrySize      .equ 8
RewriteRoutineCapacity       .equ 4
RewriteRoutineNamePointer    .equ 0 ; word
RewriteRoutineNameLength     .equ 2
RewriteRoutineParameterStart .equ 3
RewriteRoutineParameterCount .equ 4
RewriteRoutineResultType     .equ 5
RewriteRoutineLabel          .equ 6
RewriteRoutineFlags          .equ 7
RewriteRoutineFlagFails      .equ 1
RewriteRoutineFlagMain       .equ 2
RewriteRoutineFlagIncomplete .equ 4
; Call records reuse a high metadata bit to distinguish an expression result
; from a complete call statement that discards the result. For CallSource it
; lives in routineFlags; for CallService it lives in selector. It never tags,
; shortens, or otherwise constrains an address.
RewriteCallFlagKeepResult    .equ $80
RewriteRoutineTableBase      .equ RewriteFieldTableLimit
RewriteRoutineTableLimit     .equ RewriteRoutineTableBase+RewriteRoutineEntrySize*RewriteRoutineCapacity

RewriteParameterEntrySize    .equ 4
RewriteParameterCapacity     .equ 16
RewriteParameterNamePointer  .equ 0 ; word
RewriteParameterNameLength   .equ 2
RewriteParameterType         .equ 3
RewriteParameterTableBase    .equ RewriteRoutineTableLimit
RewriteParameterTableLimit   .equ RewriteParameterTableBase+RewriteParameterEntrySize*RewriteParameterCapacity

; Array suffixes are retained outermost-first and resolved innermost-first.
; Each entry preserves a full count and exact source byte offset.
RewriteSuffixEntrySize       .equ 4
RewriteSuffixCapacity        .equ 4
RewriteSuffixLength          .equ 0 ; word
RewriteSuffixSourceOffset    .equ 2 ; word
RewriteSuffixTableBase       .equ RewriteParameterTableLimit
RewriteSuffixTableLimit      .equ RewriteSuffixTableBase+RewriteSuffixEntrySize*RewriteSuffixCapacity
RewriteSuffixResumeOffset    .equ RewriteSuffixTableLimit ; word
RewriteSuffixOpenOffset      .equ RewriteSuffixResumeOffset+2 ; word

; Four recursive source/service calls are sufficient for the published
; expression-capacity boundary. Each frame is compiler metadata, not a target
; activation: parameter cursor/count, target carrier count, result, selector,
; flags, and complete call-site source offset.
RewriteCallFrameParameterCursor .equ 0
RewriteCallFrameParameterRemaining .equ 1
RewriteCallFrameArgumentWords .equ 2
RewriteCallFrameResultType    .equ 3
RewriteCallFrameSelector      .equ 4
RewriteCallFrameFlags         .equ 5
RewriteCallFrameSourceOffset  .equ 6 ; word
RewriteCallFrameSize          .equ 8
RewriteCallFrameBase          .equ RewriteSuffixOpenOffset+2
RewriteCallFrameLimit         .equ RewriteCallFrameBase+RewriteCallFrameSize*RewriteCallFrameCapacity

; Static construction uses one complete-object scratch image and one retained
; output image. Initialized bytes are the retained prefix and aggregate
; constants are the suffix. Both buffers retain the published 1 KiB boundary.
RewriteStaticPendingSource   .equ RewriteCallFrameLimit ; word
RewriteStaticPendingLength   .equ RewriteStaticPendingSource+2 ; word
RewriteStaticPendingOffset   .equ RewriteStaticPendingLength+2 ; word
RewriteStaticPendingByte     .equ RewriteStaticPendingOffset+2
RewriteStaticPendingLimit    .equ RewriteStaticPendingByte+1
; Statement parsing begins only after static construction has finished. These
; aliases retain one scalar assignment target without adding workspace or
; encoding storage identity in its full-width payload.
RewriteStatementTargetPayload .equ RewriteStaticPendingOffset ; word
RewriteStatementTargetStorage .equ RewriteStaticPendingLength
RewriteStatementTargetClass   .equ RewriteStaticPendingByte
RewriteStatementExitSourceOffset .equ RewriteStaticPendingOffset ; word
; Statement-only assignment state overlays the dead static-construction
; staging prefix. PathAssignmentMode is nonzero only while the left postfix
; chain is being selected. TargetMode survives the right expression: zero is
; a direct scalar, one is an indirect scalar/aggregate carrier, and two is an
; open-string length carrier. RetainedCarriers is copied into the declared
; call operand when a failable right expression is consumed.
RewriteStatementTargetMode      .equ RewriteStaticPendingSource
RewritePathAssignmentMode       .equ RewriteStaticPendingSource+1
RewriteStatementRetainedCarriers .equ RewriteStaticPendingLength+1
RewriteStatementTargetSourceOffset .equ RewriteStaticPendingOffset ; word
RewriteInitializerCapacity  .equ 1024
RewriteInitializerBase       .equ RewriteStaticPendingLimit
RewriteInitializerLimit      .equ RewriteInitializerBase+RewriteInitializerCapacity
; Backend generation starts only after static construction and reuses the
; dead initializer scratch prefix for complete output pointers and the current
; operation. No address bits are metadata and no workspace account grows.
RewriteBackendOutputCursor   .equ RewriteInitializerBase ; word
RewriteBackendOutputLimit    .equ RewriteInitializerBase+2 ; word
RewriteBackendCurrentOperation .equ RewriteInitializerBase+4
RewriteBackendRuntimeBase    .equ RewriteInitializerBase+5 ; word
RewriteBackendVectorBase     .equ RewriteInitializerBase+7 ; word
RewriteBackendStateBase      .equ RewriteInitializerBase+9 ; word
RewriteBackendTerminalAddress .equ RewriteInitializerBase+11 ; word
RewriteBackendDataBase       .equ RewriteInitializerBase+13 ; word
RewriteBackendBssBase        .equ RewriteInitializerBase+15 ; word
RewriteBackendReadOnlyBase   .equ RewriteInitializerBase+17 ; word
RewriteBackendReadOnlyCapacity .equ RewriteInitializerBase+19 ; word
RewriteBackendEntryBank      .equ RewriteInitializerBase+21
RewriteBackendOutputBank     .equ RewriteInitializerBase+22
RewriteBackendContextLimit   .equ RewriteInitializerBase+23
RewriteBackendRuntimeCallAddress .equ RewriteBackendContextLimit ; word
RewriteBackendTrapReason     .equ RewriteBackendContextLimit+2
RewriteBackendTrapSourceOffset .equ RewriteBackendContextLimit+3 ; word
RewriteBackendRelativeOperand .equ RewriteBackendContextLimit+5 ; word
RewriteBackendCurrentSourceOffset .equ RewriteBackendContextLimit+7 ; word
RewriteBackendBooleanFixupDepth .equ RewriteBackendContextLimit+9
RewriteBackendBooleanFixupBase .equ RewriteBackendContextLimit+10
RewriteBackendBooleanFixupCapacity .equ 16
RewriteBackendLabelCapacity    .equ RewriteControlLabelLimit
RewriteBackendMainLabel        .equ RewriteBackendLabelCapacity-1
RewriteBackendLabelValidBase   .equ RewriteBackendBooleanFixupBase+RewriteBackendBooleanFixupCapacity*2
RewriteBackendLabelBankKnownBase .equ RewriteBackendLabelValidBase+RewriteBackendLabelCapacity
RewriteBackendLabelBankBase    .equ RewriteBackendLabelBankKnownBase+RewriteBackendLabelCapacity
RewriteBackendLabelAddressBase .equ RewriteBackendLabelBankBase+RewriteBackendLabelCapacity
RewriteBackendFixupCount       .equ RewriteBackendLabelAddressBase+RewriteBackendLabelCapacity*2
RewriteBackendFixupBase        .equ RewriteBackendFixupCount+1
RewriteBackendFixupSize        .equ 5 ; label, site bank, kind, full operand address
RewriteBackendFixupCapacity    .equ 32
RewriteBackendFixupLimit       .equ RewriteBackendFixupBase+RewriteBackendFixupSize*RewriteBackendFixupCapacity
RewriteBackendFixupSameBank    .equ 0
RewriteBackendFixupAnyBank     .equ 1
RewriteBackendFarCallVectorOffset .equ 27 ; vector ordinal 9 * 3

; Target layout begins after every live backend fixup. It occupies otherwise
; dead initializer scratch and remains independent of all compiler addresses.
RewriteTargetLayoutBase       .equ RewriteBackendFixupLimit
RewriteTargetLayoutMode       .equ RewriteTargetLayoutBase
RewriteTargetFlags            .equ RewriteTargetLayoutBase+1
RewriteTargetBankCount        .equ RewriteTargetLayoutBase+2
RewriteTargetEntryBank        .equ RewriteTargetLayoutBase+3
RewriteTargetImageBase        .equ RewriteTargetLayoutBase+4 ; word
RewriteTargetImageCapacity    .equ RewriteTargetLayoutBase+6 ; word
RewriteTargetWritableBase     .equ RewriteTargetLayoutBase+8 ; word
RewriteTargetWritableCapacity .equ RewriteTargetLayoutBase+10 ; word
RewriteTargetLayoutLimit      .equ RewriteTargetLayoutBase+12
RewriteTargetOutputState      .equ RewriteTargetLayoutLimit
RewriteTargetOutputLimit      .equ RewriteTargetOutputState+1

RewriteTargetLayoutLoaded     .equ 0
RewriteTargetLayoutRom        .equ 1
RewriteTargetEstablishStack   .equ 1
RewriteTargetBankCapacity     .equ 4
RewriteTargetOutputClosed     .equ 0
RewriteTargetOutputOpen       .equ 1

; Stable Host API 1 target descriptor. All addresses and capacities are full
; words; no compiler or target address bit is repurposed as metadata.
RewriteTargetDescriptorRuntimeIdentity  .equ 0 ; word
RewriteTargetDescriptorImageBase        .equ 2 ; word
RewriteTargetDescriptorImageCapacity    .equ 4 ; word
RewriteTargetDescriptorWritableBase     .equ 6 ; word
RewriteTargetDescriptorWritableCapacity .equ 8 ; word
RewriteTargetDescriptorFlags            .equ 10
RewriteTargetDescriptorBankCount        .equ 11
RewriteTargetDescriptorEntryBank        .equ 12
RewriteTargetDescriptorPartBanksPointer .equ 13 ; word
RewriteTargetDescriptorSize             .equ 15

; Deployment supplies this full-width record to RewriteBackendInitialize.
RewriteBackendContextRuntimeBase .equ 0 ; word
RewriteBackendContextVectorBase  .equ 2 ; word
RewriteBackendContextStateBase   .equ 4 ; word
RewriteBackendContextTerminal    .equ 6 ; word
RewriteBackendContextDataBase    .equ 8 ; word
RewriteBackendContextBssBase     .equ 10 ; word
RewriteBackendContextReadOnlyBase .equ 12 ; word
RewriteBackendContextReadOnlyCapacity .equ 14 ; word
RewriteBackendContextEntryBank   .equ 16
RewriteBackendContextOutputBank  .equ 17
RewriteBackendContextSize        .equ 18
RewriteStaticImageCapacity   .equ 1024
RewriteStaticImageBase       .equ RewriteInitializerLimit
RewriteStaticImageLimit      .equ RewriteStaticImageBase+RewriteStaticImageCapacity

; Every semantic operation retains its complete source byte offset in a
; parallel word ledger. The fixed transcript stays byte-identical, while a
; compact operation such as open-string `.capacity` can still emit an exact
; target trap. Offsets are data, not packed pointers or address metadata.
RewriteSemanticSourceOffsetCapacity .equ 255
RewriteSemanticSourceOffsetBase .equ RewriteStaticImageLimit
RewriteSemanticSourceOffsetLimit .equ RewriteSemanticSourceOffsetBase+2*RewriteSemanticSourceOffsetCapacity
RewriteTargetDescriptorPointer .equ RewriteSemanticSourceOffsetLimit ; word
RewriteTargetPartCount         .equ RewriteTargetDescriptorPointer+2

; Structured-control frames are live only while compiling routine statements.
; Static initializer scratch is live only while compiling top-level static
; declarations, so the two phases share the first 88 scratch bytes. A frame
; retains complete source-independent label ordinals and full loop metadata;
; no compiler address is packed or narrowed.
RewriteControlFrameCapacity  .equ 8
RewriteControlFrameSize      .equ 10
RewriteControlFrameKind      .equ 0
RewriteControlFrameLabelA    .equ 1
RewriteControlFrameContinue  .equ 2
RewriteControlFrameExit      .equ 3
RewriteControlFrameCounter   .equ 4
RewriteControlFrameMode      .equ 5
RewriteControlFrameStep      .equ 6 ; word
RewriteControlFrameSourceOffset .equ 8 ; word
RewriteControlFrameBase      .equ RewriteInitializerBase
RewriteControlFrameLimit     .equ RewriteControlFrameBase+RewriteControlFrameSize*RewriteControlFrameCapacity
RewriteControlFlowStackBase  .equ RewriteControlFrameLimit
RewriteControlFlowStackLimit .equ RewriteControlFlowStackBase+RewriteControlFrameCapacity
RewriteControlKindIf         .equ 1
RewriteControlKindWhile      .equ 2
RewriteControlKindFor        .equ 3
RewriteControlKindHandler    .equ 4
RewriteControlNoCounter      .equ $FF
RewriteControlLabelLimit     .equ 27

RewriteWorkspaceEnd          .equ RewriteTargetPartCount+1
CompilerWorkspaceEnd         .equ RewriteWorkspaceEnd

; The test host requires an append-only sink interval even though R1 never
; opens it. These are full addresses selected by the deployment map.
AdapterLogBase               .equ RewriteAdapterBase
AdapterLogLimit              .equ RewriteAdapterLimit

; Fundamental tokens occupy a compact stable prefix. Keywords follow in the
; exact order of RewriteKeywordTable, so the table stores no token byte.
TokenEof                     .equ 0
TokenNewline                 .equ 1
TokenName                    .equ 2
TokenNumber                  .equ 3
TokenCharacter               .equ 4
TokenStringLiteral           .equ 5
TokenLeftParen               .equ 6
TokenRightParen              .equ 7
TokenLeftBracket             .equ 8
TokenRightBracket            .equ 9
TokenEquals                  .equ 10
TokenComma                   .equ 11
TokenMinus                   .equ 12
TokenPlus                    .equ 13
TokenStar                    .equ 14
TokenSlash                   .equ 15
TokenDot                     .equ 16
TokenLess                    .equ 17
TokenLessEqual               .equ 18
TokenGreater                 .equ 19
TokenGreaterEqual            .equ 20
TokenNotEqual                .equ 21

TokenFirstKeyword            .equ 32
TokenVar                     .equ TokenFirstKeyword+0
TokenAs                      .equ TokenFirstKeyword+1
TokenU8                      .equ TokenFirstKeyword+2
TokenU16                     .equ TokenFirstKeyword+3
TokenI8                      .equ TokenFirstKeyword+4
TokenI16                     .equ TokenFirstKeyword+5
TokenBoolean                 .equ TokenFirstKeyword+6
TokenTrue                    .equ TokenFirstKeyword+7
TokenFalse                   .equ TokenFirstKeyword+8
TokenConst                   .equ TokenFirstKeyword+9
TokenOr                      .equ TokenFirstKeyword+10
TokenXor                     .equ TokenFirstKeyword+11
TokenMod                     .equ TokenFirstKeyword+12
TokenAssert                  .equ TokenFirstKeyword+13
TokenAnd                     .equ TokenFirstKeyword+14
TokenNot                     .equ TokenFirstKeyword+15
TokenFail                    .equ TokenFirstKeyword+16
TokenEnd                     .equ TokenFirstKeyword+17
TokenSub                     .equ TokenFirstKeyword+18
TokenFails                   .equ TokenFirstKeyword+19
TokenFor                     .equ TokenFirstKeyword+20
TokenUntil                   .equ TokenFirstKeyword+21
TokenForward                 .equ TokenFirstKeyword+22
TokenReturn                  .equ TokenFirstKeyword+23
TokenIf                      .equ TokenFirstKeyword+24
TokenElseIf                  .equ TokenFirstKeyword+25
TokenElse                    .equ TokenFirstKeyword+26
TokenWhile                   .equ TokenFirstKeyword+27
TokenTo                      .equ TokenFirstKeyword+28
TokenStep                    .equ TokenFirstKeyword+29
TokenExit                    .equ TokenFirstKeyword+30
TokenContinue                .equ TokenFirstKeyword+31
TokenRecord                  .equ TokenFirstKeyword+32
TokenString                  .equ TokenFirstKeyword+33
TokenHandle                  .equ TokenFirstKeyword+34
TokenKeywordCount            .equ 35

DiagnosticNone               .equ 0
DiagnosticLexical            .equ 1
DiagnosticExpectedTopLevel   .equ 37
DiagnosticSemanticCapacity   .equ 40
DiagnosticForwardMismatch    .equ 53
DiagnosticForwardIncomplete  .equ 54
DiagnosticDuplicateName      .equ 55
DiagnosticSymbolCapacity     .equ 56
DiagnosticUnknownName        .equ 57
DiagnosticExpectedScalar     .equ 58
DiagnosticExpectedType       .equ 59
DiagnosticTypeMismatch       .equ 60
DiagnosticIntegerRange       .equ 61
DiagnosticDivisionZero       .equ 62
DiagnosticNarrowing          .equ 63
DiagnosticComparisonChain    .equ 64
DiagnosticExpressionCapacity .equ 65
DiagnosticBooleanFixupCapacity .equ 66
DiagnosticInternalOperation  .equ 67
DiagnosticTypeMetadataCapacity .equ 76
DiagnosticInitializerCapacity .equ 77
DiagnosticInitializerShape    .equ 78
DiagnosticInitializerCount    .equ 79
DiagnosticStringLength        .equ 80
DiagnosticProgramDataCapacity .equ 81
DiagnosticRecordEmpty        .equ 82
DiagnosticTypeBound          .equ 83
DiagnosticRoutineCapacity    .equ 84
DiagnosticParameterCapacity  .equ 85
DiagnosticFailureContext     .equ 87
DiagnosticRoutineFlow        .equ 75
DiagnosticActiveCounter      .equ 36
DiagnosticControlCapacity    .equ 68
DiagnosticControlLabelCapacity .equ 69
DiagnosticControlFixupCapacity .equ 70
DiagnosticExpectedBoolean    .equ 71
DiagnosticExpectedLoop       .equ 72
DiagnosticLoopCounter        .equ 73
DiagnosticLoopStep           .equ 74
DiagnosticSourcePartCapacity .equ 88
DiagnosticStringCapacity     .equ 90
DiagnosticReadOnlyCapacity   .equ 93
DiagnosticReadOnlyAssignment .equ 94
DiagnosticAssertionFailed    .equ 91
DiagnosticTargetConfiguration .equ 95
DiagnosticTargetCapacity     .equ 96
DiagnosticTargetOutput       .equ 97
DiagnosticFixupRange         .equ 41

; Expected-token diagnostics retain the published production-token ordinals,
; not the replacement tokenizer's private compact ordinals.
DiagnosticExpectedLeft       .equ $80+5
DiagnosticExpectedRight      .equ $80+6
DiagnosticExpectedName       .equ $80+2
DiagnosticExpectedLine       .equ $80+1
DiagnosticExpectedEqual      .equ $80+7
DiagnosticExpectedAs         .equ $80+14
DiagnosticExpectedEnd        .equ $80+12
DiagnosticExpectedLeftBracket .equ $80+18
DiagnosticExpectedRightBracket .equ $80+19
DiagnosticExpectedComma      .equ $80+20
DiagnosticExpectedFail       .equ $80+11
DiagnosticExpectedReturn     .equ $80+22
DiagnosticExpectedIf         .equ $80+TokenIf
DiagnosticExpectedStringLiteral .equ $80+47

RewriteCallModeInfallible       .equ 0
RewriteCallModePropagateRoutine .equ 1
RewriteCallModePropagateMain    .equ 2
RewriteCallModeHandle           .equ 3

RewriteExpressionOpAdd       .equ 0
RewriteExpressionOpSubtract  .equ 1
RewriteExpressionOpMultiply  .equ 2
RewriteExpressionOpDivide    .equ 3
RewriteExpressionOpModulo    .equ 4
RewriteExpressionOpEqual     .equ 5
RewriteExpressionOpNotEqual  .equ 6
RewriteExpressionOpLess      .equ 7
RewriteExpressionOpLessEqual .equ 8
RewriteExpressionOpGreater   .equ 9
RewriteExpressionOpGreaterEqual .equ 10
RewriteExpressionOpAnd       .equ 11
RewriteExpressionOpOr        .equ 12
RewriteExpressionOpXor       .equ 13
RewriteExpressionOperatorCount .equ 14

DebugTraceSemanticStartPort  .equ $DD
DebugTraceSemanticEndPort    .equ $DE

SourcePartCapacity           .equ 8
