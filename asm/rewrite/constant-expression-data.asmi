; Replacement expression operator descriptors. These are parser data, not
; encoded Z80 instructions. Each pair is token ordinal, precedence.
RewriteExpressionOperatorTable:
            .db TokenPlus,5
            .db TokenMinus,5
            .db TokenStar,6
            .db TokenSlash,6
            .db TokenMod,6
            .db TokenEquals,4
            .db TokenNotEqual,4
            .db TokenLess,4
            .db TokenLessEqual,4
            .db TokenGreater,4
            .db TokenGreaterEqual,4
            .db TokenAnd,2
            .db TokenOr,1
            .db TokenXor,1
RewriteExpressionOperatorTableEnd:

; Postfix property spellings are immutable name data, not encoded Z80
; instructions. Their explicit lengths avoid terminators in the scanner.
RewritePathNameLength:
            .db "length"
RewritePathNameCapacity:
            .db "capacity"

; Six predefined service signatures use bits 3..4 for an optional scalar
; parameter and bit 5 for a successful u8 result. The low selector bits live
; in the call record itself. These are signature data, not instructions.
RewriteServiceResultU8       .equ $20
RewriteServiceArgumentMask   .equ $18
RewriteServiceSignatureTable:
            .db RewriteServiceResultU8
            .db RewriteScalarTypeU8*8
            .db RewriteServiceResultU8
            .db 0
            .db RewriteScalarTypeU8*8
            .db RewriteScalarTypeU16*8
