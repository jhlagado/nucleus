; Replacement expression operator descriptors. These are parser data, not
; encoded Z80 instructions. Each pair is token ordinal, precedence.
RewriteExpressionOperatorTable:
            .db TokenPlus,5
            .db TokenMinus,5
            .db TokenStar,6
            .db TokenSlash,6
            .db TokenMod,6
            .db TokenEquals,4
            .db TokenNotEqual,4
            .db TokenLess,4
            .db TokenLessEqual,4
            .db TokenGreater,4
            .db TokenGreaterEqual,4
            .db TokenAnd,2
            .db TokenOr,1
            .db TokenXor,1
RewriteExpressionOperatorTableEnd:

; Rows are equal, not-equal, less, less-or-equal, greater, and
; greater-or-equal. Columns are equal, less, and greater relations.
RewriteExpressionComparisonResults:
            .db 1,0,0
            .db 0,1,1
            .db 0,1,0
            .db 1,1,0
            .db 0,0,1
            .db 1,0,1

; Scalar load operations by storage class (initialized, BSS, local,
; parameter), with byte then word width. These are semantic ordinals.
RewriteExpressionScalarLoadOperations:
            .db RewriteSemanticLoadProgramU8,   RewriteSemanticLoadProgram16
            .db RewriteSemanticLoadBssU8,       RewriteSemanticLoadBss16
            .db RewriteSemanticLoadLocalU8,     RewriteSemanticLoadLocal16
            .db RewriteSemanticLoadParameter8, RewriteSemanticLoadParameter16

; Postfix property spellings are immutable name data, not encoded Z80
; instructions. Their explicit lengths avoid terminators in the scanner.
RewritePathNameLength:
            .db "length"
RewritePathNameCapacity:
            .db "capacity"

; Six predefined service signatures use bits 3..4 for an optional scalar
; parameter, bit 5 for a successful u8 result, and bits 0..2 for the dense
; service ordinal. The parser copies only the ordinal plus keep/discard into
; the call record. These are signature data, not instructions.
RewriteServiceResultU8       .equ $20
RewriteServiceArgumentMask   .equ $18
RewriteServiceSignatureTable:
            .db RewriteServiceResultU8+0
            .db RewriteScalarTypeU8*8+1
            .db RewriteServiceResultU8+2
            .db 3
            .db RewriteScalarTypeU8*8+4
            .db RewriteScalarTypeU16*8+5
