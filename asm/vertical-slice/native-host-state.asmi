; Host-owned constants and workspace. This part emits no bytes and precedes
; the vector body so ATOM resolves its derived workspace lengths directly.

; Reference bindings of the native compiler-host vector. The vector is fixed
; Z80 ABI. The direct build yields through private proof ports; the MON3 build
; adapts the same entries to RST 10h expansion services.

%IF Mon3HostTransport
NHVECTOR  EQU $4000
NHM3SVC   EQU $70
HPMON3    EQU $E0
NHM3RST   EQU $0010
%ELSE
NHVECTOR  EQU $B000
%ENDIF

HPCHUNK   EQU $C0
HPRETAIN  EQU $C1
HPCMPNAM  EQU $C2
HPMATNAM  EQU $C3
HPBEGIN   EQU $C4
HPIMAGE   EQU $C5
HPRTIMG   EQU $C6
HPRTINIT  EQU $C7
HPPATBYT  EQU $C8
HPPATWRD  EQU $C9
HPMAP     EQU $CA
HPMAPBNK  EQU $CB
HPCOMMIT  EQU $CC
HPABORT   EQU $CD
HPLAUNCH  EQU $CE
HPFINISH  EQU $CF

%IF Mon3HostTransport
NHWORK    EQU $5800
%ELSE
NHWORK    EQU $A800
%ENDIF
NHLACTV   EQU NHWORK
NHLCOMIT  EQU NHLACTV+1
NHLDSCP   EQU NHLCOMIT+1
NHLRESP   EQU NHLDSCP+2
NHLTARG   EQU NHLRESP+2
NHLPRTS   EQU NHLTARG+2
NHRTOP    EQU NHLPRTS+1
NHRTBNK   EQU NHRTOP+1
NHRTLEN   EQU NHRTBNK+1
NHRTID    EQU NHRTLEN+2
NHRTADR   EQU NHRTID+2
NHRTCTX   EQU NHRTADR+2
NHRTSTAT  EQU NHRTCTX+2
NHRTPEND  EQU NHRTSTAT+1
NHASYNC   EQU NHRTPEND+1
%IF Mon3HostTransport
NHM3BC    EQU NHASYNC+1
NHM3C     EQU NHM3BC
NHM3B     EQU NHM3BC+1
NHWKEND   EQU NHM3BC+2
%ELSE
NHWKEND   EQU NHASYNC+1
%ENDIF

NHLDSCSZ  EQU 14
NHLMAJOR  EQU 0
NHLMINOR  EQU 1
NHLGOOD   EQU 0
NHLDIAG   EQU 1
NHLHOST   EQU 2
NHSINVAL  EQU 4
NHSCANCL  EQU 6
NHSSTORE  EQU 3
