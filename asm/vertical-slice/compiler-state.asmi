; Fixed state for the first Nucleus compiler proof.
;
; All addresses are within the compiler-workspace account. The symbols make
; the peak writable extent directly measurable from the ATOM symbol map.

CPSTBASE       EQU MMWORK

SSPARTID            EQU CPSTBASE+$00
SSCUR            EQU CPSTBASE+$01
SSEND               EQU CPSTBASE+$03
SSOFF            EQU CPSTBASE+$05
SSLINE              EQU CPSTBASE+$07
SSCOL            EQU CPSTBASE+$09
SSLNTOK       EQU CPSTBASE+$0B
SSDELDEP    EQU CPSTBASE+$0C
TNEOFPND     EQU CPSTBASE+$0D

TNKIND               EQU CPSTBASE+$0E
TNVALUE              EQU CPSTBASE+$0F
TNSTOFF        EQU CPSTBASE+$10
TNSTLINE          EQU CPSTBASE+$12
TNSTCOL        EQU CPSTBASE+$14
TNLEXPTR      EQU CPSTBASE+$16
TNLEN             EQU CPSTBASE+$18

PSOUTBYT        EQU CPSTBASE+$19
DGCODE          EQU CPSTBASE+$1A
DGPARTID        EQU CPSTBASE+$1B
DGOFF        EQU CPSTBASE+$1C
DGLINE          EQU CPSTBASE+$1E
DGCOL        EQU CPSTBASE+$20

SKCUR              EQU CPSTBASE+$22
SKOPCNT      EQU CPSTBASE+$24
GNSZ           EQU CPSTBASE+$25

CPSTEND        EQU CPSTBASE+$27
SMBUFBAS      EQU CPSTEND
SMBUFLIM     EQU SMBUFBAS+$10
CPWKEND    EQU SMBUFLIM

; Token ordinals needed by the fixed Stage-3 program.
TOKENEOF                EQU 0
TNNL            EQU 1
TNNAME               EQU 2
TNCHAR          EQU 3
TNLPAR          EQU 4
TNRPAR         EQU 5
TOKENSUB                EQU 6
TNFAILS              EQU 7
TNELSE               EQU 8
TNFAIL               EQU 9
TOKENEND                EQU 10

; First-failure diagnostics. Values are proof-visible and intentionally small.
DGNONE          EQU 0
DGLEX       EQU 1
DXSUB   EQU 16
DXMAIN  EQU 17
DXLPAR  EQU 18
DXRPAR EQU 19
DXFAILS EQU 20
DXLINE  EQU 21
DXWR EQU 22
DXCHAR  EQU 23
DXELSE  EQU 24
DXFAIL  EQU 25
DXEND   EQU 26
DXEOF   EQU 27
DGSNKCAP  EQU 32

; Checked semantic-operation stream ordinals.
SMLDU8          EQU 1
SMWROBYT EQU 2
SMPROP       EQU 3
SMRET          EQU 4
