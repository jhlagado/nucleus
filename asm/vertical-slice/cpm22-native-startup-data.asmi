CUOTEXT:     DB " O=","$"
CULTEXT:       DB " L=","$"
CUCTEXT:     DB " C=","$"
CUHELPXT:       DB 13,10,"NUC [SOURCE [OUTPUT.COM|OUTPUT.BIN|OUTPUT.HEX]]",13,10,"$"
CUNL:        DB 13,10,"$"
CUIMMEND:
CURESEND:
