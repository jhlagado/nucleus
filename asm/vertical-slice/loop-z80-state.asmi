; Writable state for the direct-Z80 counted-loop proof target.

RTSTATE         .equ MMEXEC
RunState          .equ RTSTATE+$00
RTTRPNO        .equ RTSTATE+$01
RTTRPRTN       .equ RTSTATE+$02
RTTRPOFF        .equ RTSTATE+$03
RTTRPERR         .equ RTSTATE+$05
RTDEPTH   .equ RTSTATE+$06
RTACTLIM   .equ RTSTATE+$07
RTSCALAR        .equ RTSTATE+$08
RTACTMEM   .equ RTSTATE+$09
RTACTCAP .equ 8
RootSP            .equ RTACTMEM+RTACTCAP
RootIX            .equ RootSP+2
StateEnd          .equ RootIX+2

RunReady          .equ 1
RTSUCC      .equ 2
RTTRAP        .equ 3

ServiceFailureCall      .equ MMSERV+$00
ServiceCallCount        .equ MMSERV+$01
ServiceOutputLength     .equ MMSERV+$02
ServiceOutputBase       .equ MMSERV+$03
ServiceOutputCapacity   .equ 4
ServiceInputLength      .equ MMSERV+$07
ServiceInputCursor      .equ MMSERV+$08
ServiceInputFailure     .equ MMSERV+$09
ServiceInputBase        .equ MMSERV+$0A
ServiceInputCapacity    .equ 4
ServiceStorageInputLength  .equ MMSERV+$0E
ServiceStorageInputCursor  .equ MMSERV+$0F
ServiceStorageInputFailure .equ MMSERV+$10
ServiceStorageInputBase    .equ MMSERV+$11
ServiceStorageInputCapacity .equ 4
ServiceStorageOutputLength  .equ MMSERV+$15
ServiceStorageOutputCursor  .equ MMSERV+$16
ServiceStorageOutputFailure .equ MMSERV+$17
ServiceStorageOutputBase    .equ MMSERV+$18
ServiceStorageOutputCapacity .equ 4
ServiceStateEnd         .equ ServiceStorageOutputBase+ServiceStorageOutputCapacity

ProgramSize       .equ 54
LoopFailureOffset .equ 30
            .if TargetStreamingOutput
            .else
GeneratedEnd      .equ MMGEN+ProgramSize
            .endif

ArrayProgramSize  .equ 74
ArrayInputFailureOffset .equ 0
ArrayBoundsOffset .equ 10
ArrayOutputFailureOffset .equ 22
            .if TargetStreamingOutput
            .else
GeneratedArrayEnd       .equ MMGEN+ArrayProgramSize
            .endif

CallProgramSize   .equ 99
CallFailureOffset .equ 95
CallCapacityOffset .equ 203
            .if TargetStreamingOutput
            .else
GeneratedCallEnd        .equ MMGEN+CallProgramSize
            .endif
