; Writable state for the direct-Z80 counted-loop proof target.

RTSTATE         .equ ExecutionBase
RunState          .equ RTSTATE+$00
RTTRPNO        .equ RTSTATE+$01
RTTRPRTN       .equ RTSTATE+$02
RTTRPOFF        .equ RTSTATE+$03
RTTRPERR         .equ RTSTATE+$05
RTDEPTH   .equ RTSTATE+$06
RTACTLIM   .equ RTSTATE+$07
RTSCALAR        .equ RTSTATE+$08
RTACTMEM   .equ RTSTATE+$09
RTACTCAP .equ 8
RootSP            .equ RTACTMEM+RTACTCAP
RootIX            .equ RootSP+2
StateEnd          .equ RootIX+2

RunReady          .equ 1
RTSUCC      .equ 2
RTTRAP        .equ 3

ServiceFailureCall      .equ ServiceBase+$00
ServiceCallCount        .equ ServiceBase+$01
ServiceOutputLength     .equ ServiceBase+$02
ServiceOutputBase       .equ ServiceBase+$03
ServiceOutputCapacity   .equ 4
ServiceInputLength      .equ ServiceBase+$07
ServiceInputCursor      .equ ServiceBase+$08
ServiceInputFailure     .equ ServiceBase+$09
ServiceInputBase        .equ ServiceBase+$0A
ServiceInputCapacity    .equ 4
ServiceStorageInputLength  .equ ServiceBase+$0E
ServiceStorageInputCursor  .equ ServiceBase+$0F
ServiceStorageInputFailure .equ ServiceBase+$10
ServiceStorageInputBase    .equ ServiceBase+$11
ServiceStorageInputCapacity .equ 4
ServiceStorageOutputLength  .equ ServiceBase+$15
ServiceStorageOutputCursor  .equ ServiceBase+$16
ServiceStorageOutputFailure .equ ServiceBase+$17
ServiceStorageOutputBase    .equ ServiceBase+$18
ServiceStorageOutputCapacity .equ 4
ServiceStateEnd         .equ ServiceStorageOutputBase+ServiceStorageOutputCapacity

ProgramSize       .equ 54
LoopFailureOffset .equ 30
            .if TargetStreamingOutput
            .else
GeneratedEnd      .equ GeneratedBase+ProgramSize
            .endif

ArrayProgramSize  .equ 74
ArrayInputFailureOffset .equ 0
ArrayBoundsOffset .equ 10
ArrayOutputFailureOffset .equ 22
            .if TargetStreamingOutput
            .else
GeneratedArrayEnd       .equ GeneratedBase+ArrayProgramSize
            .endif

CallProgramSize   .equ 99
CallFailureOffset .equ 95
CallCapacityOffset .equ 203
            .if TargetStreamingOutput
            .else
GeneratedCallEnd        .equ GeneratedBase+CallProgramSize
            .endif
