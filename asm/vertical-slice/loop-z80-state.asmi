; Writable state for the direct-Z80 counted-loop proof target.

RTSTATE   EQU MMEXEC
RUNSTATE  EQU RTSTATE+$00
RTTRPNO   EQU RTSTATE+$01
RTTRPRTN  EQU RTSTATE+$02
RTTRPOFF  EQU RTSTATE+$03
RTTRPERR  EQU RTSTATE+$05
RTDEPTH   EQU RTSTATE+$06
RTACTLIM  EQU RTSTATE+$07
RTSCALAR  EQU RTSTATE+$08
RTACTMEM  EQU RTSTATE+$09
RTACTCAP  EQU 8
ROOTSP    EQU RTACTMEM+RTACTCAP
ROOTIX    EQU ROOTSP+2
STATEEND  EQU ROOTIX+2

RUNREADY  EQU 1
RTSUCC    EQU 2
RTTRAP    EQU 3

SVFAIL    EQU MMSERV+$00
SVCALLS   EQU MMSERV+$01
VOUTLEN   EQU MMSERV+$02
VOUTBAS   EQU MMSERV+$03
VOUTCAP   EQU 4
VINLEN    EQU MMSERV+$07
VINCUR    EQU MMSERV+$08
VINFAIL   EQU MMSERV+$09
VINBAS    EQU MMSERV+$0A
VINCAP    EQU 4
VSILEN    EQU MMSERV+$0E
VSICUR    EQU MMSERV+$0F
VSIFAIL   EQU MMSERV+$10
VSIBAS    EQU MMSERV+$11
VSICAP    EQU 4
VSOLEN    EQU MMSERV+$15
VSOCUR    EQU MMSERV+$16
VSOFAIL   EQU MMSERV+$17
VSOBAS    EQU MMSERV+$18
VSOCAP    EQU 4
SVEND     EQU VSOBAS+VSOCAP

PGSZ      EQU 54
LPFAIL    EQU 30
%IF TargetStreamingOutput
%ELSE
GNEND     EQU MMGEN+PGSZ
%ENDIF

ARYPGSZ   EQU 74
ARYIFAIL  EQU 0
ARYBOFF   EQU 10
ARYOFAIL  EQU 22
%IF TargetStreamingOutput
%ELSE
GNARREND  EQU MMGEN+ARYPGSZ
%ENDIF

CLPROGSZ  EQU 99
CLFAIL    EQU 95
CLCAPOFF  EQU 203
%IF TargetStreamingOutput
%ELSE
GNCALEND  EQU MMGEN+CLPROGSZ
%ENDIF
