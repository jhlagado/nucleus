; End-to-end coverage for the packed LL(1) Stage 7 parser.

            .include "memory-map.asmi"
SegmentedOutput .equ 1
            .include "loop-compiler-state.asmi"
            .include "aggregate-call-state.asmi"
            .include "loop-z80-state.asmi"

            .org MMCORE
KCSTART:
LegacyCompilerSlices .equ 0
AggregateCallSlices  .equ 1
KCSRC:
            .include "source-adapter.asm"
KCSRCEND:
KCTOKEN:
            .include "loop-tokenizer.asm"
KCTOKEND:
KCSEM:
            .include "loop-semantic-sink.asm"
KCSEMEND:
KCSYM:
            .include "loop-symbols.asm"
KCSYMEND:
KCPARSER:
            .include "compiler-profile-legacy.asmi"
            .include "loop-parser.asm"
KCPAREND:
KCCOMEND:
KCSINK:
LegacyEncoders .equ 0
            .include "loop-z80-sink.asm"
KCTYPED:
            .include "typed-expression-z80.asm"
            .include "aggregate-z80.asm"
KCTYPEND:
KCSNKEND:
KCCODEND:
KCIMM:
            .include "loop-keywords.asmi"
KCIMMEND:
KCEND:

            .org MMSOURCE
Stage7ParserCoverageSource:
            .db "var out as u8 = 0",10
            .db "var finalI as u8 = 0",10
            .db "var finalJ as u16 = 0",10
            .db "sub main() fails",10
            .db "var i as u8",10
            .db "var j as u16 = 3",10
            .db "if false",10
            .db "out = 99",10
            .db "elseif true",10
            .db "out = 1",10
            .db "else",10
            .db "out = 98",10
            .db "end",10
            .db "while out < 3",10
            .db "out = out + 1",10
            .db "end",10
            .db "for i = 0 until 4",10
            .db "if i = 1",10
            .db "continue",10
            .db "end",10
            .db "if i = 3",10
            .db "exit",10
            .db "end",10
            .db "out = out + i",10
            .db "end",10
            .db "for j = 3 to 0 step -1",10
            .db "out = out + 1",10
            .db "end",10
            .db "finalI = i",10
            .db "finalJ = j",10
            .db "writeOutputByte(out) else fail",10
            .db "end",10
Stage7ParserCoverageSourceEnd:

; Exercise constant declarations and named counted-loop steps separately from
; the larger control-flow program.
Stage7LL1ConstantSource:
            .db "const stepSize = 1",10
            .db "var out as u8 = 0",10
            .db "sub main() fails",10
            .db "var i as u8",10
            .db "for i = 0 until 2 step stepSize",10
            .db "out = out + stepSize",10
            .db "end",10
            .db "writeOutputByte(out) else fail",10
            .db "end",10
Stage7LL1ConstantSourceEnd:

            .org MMRUN
RTSTART:
RuntimeProofServices .equ 1
RuntimePacketGateway .equ 0
            .include "proof-z80-runtime.asm"
RTEND:

            .org MMPROOF
.routine out carry,zero clobbers sign,parity,halfCarry,A,BC,DE,HL,IX,IY
FPSTART:
            LD   SP,STACKTOP
            XOR  A
            LD   (FPSTATUS),A
            LD   (FPCASE),A
            LD   A,160
            LD   HL,Stage7LL1ConstantSource
            LD   DE,Stage7LL1ConstantSourceEnd
            CALL CPAGCLSL
            JP   C,ProofConstantCompileFailure
            CALL ZGPROG
            JP   C,ProofConstantEncodeFailure
            CALL RESET
            CALL ProofCallGenerated
            JP   C,ProofConstantFrameFailure
            LD   A,(RUNSTATE)
            CP   RTSUCC
            JP   NZ,ProofConstantRunFailure
            LD   A,(VOUTLEN)
            CP   1
            JP   NZ,ProofConstantOutputFailure
            LD   A,(VOUTBAS)
            CP   2
            JP   NZ,ProofConstantOutputFailure
            LD   A,160
            LD   HL,Stage7ParserCoverageSource
            LD   DE,Stage7ParserCoverageSourceEnd
            CALL CPAGCLSL
            JR   C,FPCOMPFL
            CALL ZGPROG
            JR   C,ProofEncodeFailure
            LD   HL,(GNSZ)
            LD   (ProofGeneratedSize),HL
            CALL RESET
            CALL ProofCallGenerated
            JR   C,ProofFrameFailure
            LD   A,(RUNSTATE)
            CP   RTSUCC
            JR   NZ,ProofRunFailure
            LD   A,(VOUTLEN)
            CP   1
            JR   NZ,ProofOutputFailure
            LD   A,(VOUTBAS)
            CP   9
            JR   NZ,ProofOutputFailure
            LD   A,(MMDATA+1)
            CP   3
            JR   NZ,ProofOutputFailure
            LD   A,(MMDATA+2)
            OR   A
            JR   NZ,ProofOutputFailure
            LD   A,(MMDATA+3)
            OR   A
            JR   NZ,ProofOutputFailure
            LD   A,$A5
            LD   (FPSTATUS),A
            HALT

FPCOMPFL:
            LD   A,1
            JR   ProofFailed
ProofEncodeFailure:
            LD   A,2
            JR   ProofFailed
ProofFrameFailure:
            LD   A,3
            JR   ProofFailed
ProofRunFailure:
            LD   A,4
            JR   ProofFailed
ProofOutputFailure:
            LD   A,5
            JR   ProofFailed
ProofConstantCompileFailure:
            LD   A,6
            JR   ProofFailed
ProofConstantEncodeFailure:
            LD   A,7
            JR   ProofFailed
ProofConstantFrameFailure:
            LD   A,8
            JR   ProofFailed
ProofConstantRunFailure:
            LD   A,9
            JR   ProofFailed
ProofConstantOutputFailure:
            LD   A,10
ProofFailed:
            LD   (FPCASE),A
            HALT

; The generated program must restore both the root hardware stack and IX.
.routine out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
ProofCallGenerated:
            LD   HL,0
            ADD  HL,SP
            LD   (ProofExpectedSP),HL
            LD   IX,$A55A
            CALL MMGEN
            PUSH IX
            POP  DE
            LD   HL,$A55A
            OR   A
            SBC  HL,DE
            JR   NZ,ProofCallGeneratedFailure
            LD   HL,0
            ADD  HL,SP
            LD   DE,(ProofExpectedSP)
            OR   A
            SBC  HL,DE
            RET  Z
ProofCallGeneratedFailure:
            SCF
            RET

ProofExpectedSP:   .dw 0
ProofGeneratedSize: .dw 0
FPSTATUS:        .db 0
FPCASE:          .db 0
FPEND:
