; Prove that a live control region may use $0000 as the exclusive $10000 end.

LVCBASE    EQU $1000
LVCLIMIT   EQU $3000
LVWKBASE   EQU $3000
LVSTKBAS   EQU $3F00
LVSTKLIM   EQU $4000
LVOBJBA    EQU 0
LVOBJLIM   EQU 0
LVPLBASE   EQU $6000
LVPCLBAS   EQU $6000
LVPCLLIM   EQU $6400
LVCTLBA    EQU $F000
LVCTLLIM   EQU 0
