; Writable state exposed by the direct-Z80 proof target.

RTSTATE         .equ ExecutionBase
RunState          .equ RTSTATE+$00
RTTRPNO        .equ RTSTATE+$01
RTTRPRTN       .equ RTSTATE+$02
RTTRPOFF        .equ RTSTATE+$03
RTTRPERR         .equ RTSTATE+$05
StateEnd          .equ RTSTATE+$06

RunReady          .equ 1
RTSUCC      .equ 2
RTTRAP        .equ 3

ServiceForceFailure     .equ ServiceBase+$00
ServiceOutputLength     .equ ServiceBase+$01
ServiceOutputByte       .equ ServiceBase+$02
ServiceStateEnd         .equ ServiceBase+$03

ProgramSize       .equ 37
FailureOffset     .equ 13
GeneratedEnd      .equ GeneratedBase+ProgramSize
