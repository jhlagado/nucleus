; Fixed compiler-host vector bindings for the native CP/M transient.

CpmCompilerHostVectorStart:
            .db "NH",0,1,8,14,0,0
.routine out A,C,DE,HL,carry,zero clobbers sign,parity,halfCarry,B
HVCHUNK:           JP CSNEXT
.routine in HL,B,C,DE out A,HL,carry,zero clobbers sign,parity,halfCarry
HVRETAIN:         JP CSRETAIN
.routine in HL,IX,B out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL
HVCMPNAM:        JP CSCMPNAM
.routine in HL out A,B,HL,carry,zero clobbers sign,parity,halfCarry
HVMATNAM:           JP CSMATNAM
.routine in IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TargetSinkBegin:               JP DOBEGIN
.routine in A,C,HL out A,carry,zero clobbers sign,parity,halfCarry,DE
TargetSinkImageByte:           JP DOIMGBYT
.routine in A,BC,DE,HL,IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TargetSinkRuntimeImage:        JP DORTIMG
.routine in A,BC,DE,HL,IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TargetSinkRuntimeInitialImage: JP DORTINIT
.routine in A,C,HL out A,carry,zero clobbers sign,parity,halfCarry,DE
TargetSinkPatchByte:           JP DOPATBYT
.routine in C,DE,HL out A,carry,zero clobbers sign,parity,halfCarry
TargetSinkPatchWord:           JP CpmCompilerPatchWord
.routine in IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TargetSinkMapFlat:             JP DOMAP
.routine in IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TargetSinkMapBanked:           JP DOMAP
.routine out A,carry,zero clobbers sign,parity,halfCarry
TargetSinkCommit:              JP CpmCompilerCommit
.routine out A,carry,zero clobbers sign,parity,halfCarry
TargetSinkAbort:               JP CpmCompilerAbort
CpmCompilerHostVectorEnd:

CpmCompilerHostAdaptersStart:
.routine in C,DE,HL out A,carry,zero clobbers sign,parity,halfCarry
CpmCompilerPatchWord:
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            CALL DOPATWRD
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            RET

.routine out A,carry,zero clobbers sign,parity,halfCarry
CpmCompilerCommit:
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            CALL DOCOMMIT
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            RET

.routine out A,carry,zero clobbers sign,parity,halfCarry
CpmCompilerAbort:
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            CALL DOABORT
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            RET
CpmCompilerHostAdaptersEnd:
