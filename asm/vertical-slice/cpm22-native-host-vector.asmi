; Fixed compiler-host vector bindings for the native CP/M transient.

CHVECTOR:
            DB "NH",0,1,8,14,0,0
; Contract: out A,C,DE,HL,carry,zero clobbers sign,parity,halfCarry,B
HVCHUNK:           JP CSNEXT
; Contract: in HL,B,C,DE out A,HL,carry,zero clobbers sign,parity,halfCarry
HVRETAIN:         JP CSRETAIN
; Contract: in HL,IX,B out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL
HVCMPNAM:        JP CSCMPNAM
; Contract: in HL out A,B,HL,carry,zero clobbers sign,parity,halfCarry
HVMATNAM:           JP CSMATNAM
; Contract: in IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TSBEGIN:               JP DOBEGIN
; Contract: in A,C,HL out A,carry,zero clobbers sign,parity,halfCarry,DE
TSBYTE:           JP DOIMGBYT
; Contract: in A,BC,DE,HL,IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TSRTIMG:        JP DORTIMG
; Contract: in A,BC,DE,HL,IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TSRTINIT: JP DORTINIT
; Contract: in A,C,HL out A,carry,zero clobbers sign,parity,halfCarry,DE
TSPATBYT:           JP DOPATBYT
; Contract: in C,DE,HL out A,carry,zero clobbers sign,parity,halfCarry
TSPATWRD:           JP CHPATCH
; Contract: in IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TSMAP:             JP DOMAP
; Contract: in IX out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
TSBANK:           JP DOMAP
; Contract: out A,carry,zero clobbers sign,parity,halfCarry
TSCOMMIT:              JP CHCOMMIT
; Contract: out A,carry,zero clobbers sign,parity,halfCarry
TSABORT:               JP CHABORT
CHVEND:

CHADAPT:
; Contract: in C,DE,HL out A,carry,zero clobbers sign,parity,halfCarry
CHPATCH:
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            CALL DOPATWRD
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            RET

; Contract: out A,carry,zero clobbers sign,parity,halfCarry
CHCOMMIT:
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            CALL DOCOMMIT
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            RET

; Contract: out A,carry,zero clobbers sign,parity,halfCarry
CHABORT:
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            CALL DOABORT
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            RET
CHAEND:
