; Packed aggregate-call and Stage 8 routine state. Sixteen direct routine entries,
; twenty-six retained parameter positions, and four nested parser call frames are
; bounded independently. Source bytes remain resident, so names use
; pointer/length pairs. Types are the Stage 6 one-byte ordinals.

HYLLCAP   EQU 64

S7STATE   EQU AGWKEND
R7CNT     EQU S7STATE+$00
P7CNT     EQU S7STATE+$01
; The current signature follows the retained routine-table byte order so the
; forward restore and routine publication paths can copy complete runs.
C7PARST   EQU S7STATE+$02
C7PARCNT  EQU S7STATE+$03
C7RESTYP  EQU S7STATE+$04
S7CALLBL  EQU S7STATE+$05
C7FLGS    EQU S7STATE+$06
S7PATHT   EQU S7STATE+$07
S7PATHEX  EQU S7STATE+$08 ; word
S7PATHOF  EQU S7STATE+$0A ; word
S7ARGIDX  EQU S7STATE+$0C
S7ARGCNT  EQU S7STATE+$0D
S7CALRES  EQU S7STATE+$0E
C7RTN     EQU S7STATE+$0F
S7CALOFF  EQU S7STATE+$10
S7CALDEP  EQU S7STATE+$12
S7GLBCNT  EQU S7STATE+$13
S8FAIOFF  EQU S7STATE+$14
S8DIRFBL  EQU S7STATE+$16
M8PTR     EQU S7STATE+$17
S8FMFLG   EQU S7STATE+$19
; Number of already-evaluated destination carriers below a failable result.
; A local handler discards these before entering its statement body.
S8CARR    EQU S7STATE+$1A
; These values span expression parsing, so nested calls must not overlay them.
V8ID      EQU S7STATE+$1B
S8CALFLG  EQU S7STATE+$1C
S7OVCOFF  EQU S7STATE+$1D
S7PASMOD  EQU S7STATE+$1E
S7SROFF   EQU S7STATE+$1F
; Counted-loop parsing spans start, bound and step expressions. Keep its source
; anchor in durable Stage 7 state rather than expression or initializer scratch.
S7FOROFF  EQU S7STATE+$20 ; word
S7STEND   EQU S7STATE+$22

R7TABBAS  EQU S7STEND
R7ENTSZ   EQU 8
R7CAP     EQU 16
R7TABLIM  EQU R7TABBAS+R7ENTSZ*R7CAP
R7NAMPTR  EQU 0
R7NAMLEN  EQU 2
R7PARST   EQU 3
R7PARCNT  EQU 4
R7RESTYP  EQU 5
R7LBL     EQU 6
R7FLGS    EQU 7

P7TABBAS  EQU R7TABLIM
P7ENTSZ   EQU 4
P7CAP     EQU 26
P7TABLIM  EQU P7TABBAS+P7ENTSZ*P7CAP
P7NAMPTR  EQU 0
P7NAMLEN  EQU 2
P7TYP     EQU 3

F7BAS     EQU P7TABLIM
F7SZ      EQU 8
F7CAP     EQU 4
F7LIM     EQU F7BAS+F7SZ*F7CAP
F7RTNIDX  EQU (F7BAS-R7TABBAS)/R7ENTSZ
F7LBL     EQU 0
F7RES     EQU 1
F7PAR     EQU 2
F7REM     EQU 3
F7ARGCNT  EQU 4
F7OFF     EQU 5
F7FLGS    EQU 7

S7WKEND   EQU F7LIM

; The multipart adapter retains one packed byte. Bit 7 records a pending
; boundary newline, bit 6 records a consumed streaming end-part event, bits
; 3..5 retain the current manifest ordinal, and bits 0..2 retain the number of
; later parts. SourcePartCapacity=8 makes every field exact.
%IF NativeStreamingSource
; Zero means no token needs pinning, one means an active token remains wholly
; in the current chunk, and a value at NativeSourceTokenBase or above is the
; next token-scratch byte. SegmentStart is the first uncopied byte in the live
; chunk after pinning begins.
SSPINSEG  EQU S7WKEND ; word
SSPINCUR  EQU SSPINSEG+2 ; word
SSPROVID  EQU SSPINCUR+2
SSPREM    EQU SSPROVID+1
SSHOST    EQU SSPREM+1
%ELSE
; The resident compatibility adapter retains the next external descriptor.
SSPDCUR   EQU S7WKEND
SSPREM    EQU SSPDCUR+2
%ENDIF
%IF NativeStreamingSource
SSMEND    EQU SSHOST+1
%ELSE
SSMEND    EQU SSPREM+1
%ENDIF
SSPDSZ    EQU 5
SRCPARTS  EQU 8
SSPREMM   EQU $07
SSPORDSH  EQU 3
SSPORDST  EQU 8
SSPORDMS  EQU $38
SSPNL     EQU $80
SSPEND    EQU $40

; Emission begins only after parsing has published the semantic transcript, so
; its consecutive call fields overlay the no-longer-live declaration prefix.
E8FLDBAS  EQU S7STATE
E8CALFLG  EQU E8FLDBAS+$00
E8RESTYP  EQU E8FLDBAS+$01
E8CALMOD  EQU E8FLDBAS+$02
E8HDLLBL  EQU E8FLDBAS+$03
E8CARR    EQU E8FLDBAS+$04

R7LBLBAS  EQU 32
; Label 31 is the callable body of main. The startup wrapper calls this label
; just like a source call, while labels 32..47 retain ordinary routines.
S7MAINLB  EQU 31
S7CTLLIM  EQU S7MAINLB
S7MAINRT  EQU $FE
S7NORES   EQU 0
R7FAILS   EQU 1
R7MAIN    EQU 2
S8RTNINC  EQU 4
; Target bank ordinals occupy unused routine/symbol metadata bits. The first
; banked profile is deliberately bounded to four banks.
TBKCAP    EQU 4
TBKSHFT   EQU 4
TBKMSK    EQU $30

M8INF     EQU 0
M8PROP    EQU 1
M8PROMN   EQU 2
M8HDL     EQU 3

; Stage 7 semantic operations extend the dense production dispatch range.
SMBGGRTN  EQU 82
SMBINDP   EQU 83
SMCALLG   EQU 84
SMRETAGG  EQU 85
SMENGRTN  EQU 86
SMLDPALS  EQU 87
SMLDPARA  EQU 88
SMSELFLD  EQU 89
SMSELIDX  EQU 90
SMLDIND8  EQU 91
SMLDIN16  EQU 92
SMSTIND8  EQU 93
SMSTIN16  EQU 94
SMCOPYAG  EQU 95
SMSTRLEN  EQU 96
SMSTRIDX  EQU 97
SMFAILRT  EQU 98
SMFAILMN  EQU 99
SMRTFS    EQU 100
SMRTFA    EQU 101
SMENFRTN  EQU 102
SMSKIPHD  EQU 103
SMBEGHDL  EQU 104
SMENDHDL  EQU 105
SMBGCMN   EQU 106
SMLDROAL  EQU 107
SMOSLEN   EQU 108
SMOSIDX   EQU 109
SMOPENAR  EQU 110
SMSTRCAP  EQU 111
SMSTRRSZ  EQU 112
SMARRLEN  EQU 113
SMOALEN   EQU 114
SMOAIDX   EQU 115
V8RDIN    EQU 0
V8WROUT   EQU 1
V8RDSTOR  EQU 2
V8REWST   EQU 3
V8WRSTOR  EQU 4
V8SEEKST  EQU 5
P8PORT    EQU 6
P8PKTSVC  EQU 8
P8CONST   EQU 9

; One completed call selector carries the target kind, successful-result
; retention choice, and dense target ID. Source labels occupy 31..47 and
; service IDs occupy 0..5, so both fit without widening the transcript.
C8SVCFLG  EQU $80
C8KEEP    EQU $40
C8SRCMSK  EQU $3F
C8SVCMSK  EQU $07

; Service selectors use their otherwise-free middle bits for the fixed
; signature: optional scalar parameter type in bits 3..4 and a successful u8
; result in bit 5. Every service is failable.
V8ARGMSK  EQU $18
V8ARGU16  EQU $10
V8RESU8   EQU $20

DGRTNCAP  EQU 84
DGPARCAP  EQU 85
DGTRNALS  EQU 86
DGFAICTX  EQU 87
DGSPTCAP  EQU 88
