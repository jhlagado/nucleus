; Canonical operating-layer runtime ABI revision. This is a compatibility tag,
; not an address or offset. Revision $000A moves the per-program writable-data
; bounds from helper instruction operands into initialized runtime state.
RIABI       EQU $000A
RIBYTES EQU 732

RIVECCNT  EQU 12
RIVECBYT EQU RIVECCNT*3
RISTBYT  EQU 41
RORUNST        EQU 0
ROACTLIM EQU 7
; Banked targets use ScalarSlot as the selected-bank byte. The activation and
; far-return arenas retain caller-bank and return-address slots at depth-1.
; General source calls do not use the legacy scalar carrier in this mode.
ROCURBNK     EQU 8
RODBASE EQU 37
RODCAP EQU 39

ROAPUSH      EQU 0
ROAPOP       EQU 23
ROACLM     EQU 43
ROAREL   EQU 68
ROARRIX      EQU 77
ROSTRLEN    EQU 85
ROSTRIDX     EQU 95
ROREGCHK EQU 115
ROBSS        EQU 161
ROMUL8           EQU 175
ROMUL16          EQU 183
RODIV16            EQU 229
ROMOD16            EQU 237
ROCMP16           EQU 290
RORESIZE          EQU 370
ROCONV        EQU 396
ROSCMP          EQU 468
ROSDIV           EQU 501
ROSSTEP         EQU 591
ROI8PAIR           EQU 676
ROPACKET    EQU 690
