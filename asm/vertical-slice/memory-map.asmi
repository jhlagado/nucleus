; Nucleus vertical-slice proof memory map
;
; Every end symbol is exclusive. The map keeps the 16 KiB compiler-core gate
; visible while giving every other account a distinct, bounded proof region.

; Entry files select the resident or streaming source adapter explicitly.

MMCORE     EQU $0000
MMCORLIM   EQU $4000

MMWORK     EQU $4000
MMWRKLIM   EQU $5000

MMSOURCE   EQU $5000
MMSRCLIM   EQU $5800

MMGEN      EQU $5800
MMGENLIM   EQU $6800

; Historical direct-sink module proofs retain this complete-image region and
; its segmented variant. Production target proofs use target-memory-map.asmi
; and therefore cannot resolve these symbols.
MMGENCOD   EQU MMGEN
MMGCEND    EQU $6400
RORDATA    EQU MMGCEND
MMROEND    EQU MMGENLIM

MMRUN      EQU $6800
MMRUNEND   EQU $7800

MMEXEC     EQU $7800
MMEXEND    EQU $8800

; Runtime state occupies the first page of ExecutionBase. Mutable initialized
; data and zero-initialized data occupy adjacent target regions after it.
MMDATA     EQU MMEXEC+$0100
MMDATEND   EQU MMDATA+$0400
MMBSS      EQU MMDATEND
MMBSSEND   EQU MMBSS+$0400
MMREGEND   EQU MMBSSEND
MMREGCAP   EQU MMREGEND-MMDATA
RORDCAP    EQU MMROEND-RORDATA

MMSERV     EQU $8800
MMSRVEND   EQU $9000

MMPROOF    EQU $9000
MMPREND    EQU $9800

MMSPARE    EQU $9800
MMSPEND    EQU $F000

; Historical direct-sink module proofs keep the prior published image here.
; Production target proofs release and account for this complete 4 KiB range.
MMBACK     EQU $A000
MMBKEND    EQU $B000

MMSTKBOT   EQU $F000
STACKTOP   EQU $FF00

MMHIGH     EQU $FF00
; Highest address is a native word; host output reports its exclusive end +1.
MMLAST     EQU $FFFF
