; Keywords are grouped by spelling length. The scanner selects one group with
; the bounded offsets below; bit 7 marks each group's final token descriptor.
; The low seven bits remain the published token ordinal.

; Each byte is a displacement from its own cell to the selected group. The
; scanner adds it to the full-width cell address; no address bits are packed.
KeywordLengthOffsets:
            .db  KeywordLength2-(KeywordLengthOffsets+0)
            .db  KeywordLength3-(KeywordLengthOffsets+1)
            .db  KeywordLength4-(KeywordLengthOffsets+2)
            .db  KeywordLength5-(KeywordLengthOffsets+3)
            .db  KeywordLength6-(KeywordLengthOffsets+4)
            .db  KeywordLength7-(KeywordLengthOffsets+5)
            .db  KeywordLength8-(KeywordLengthOffsets+6)

KeywordTable:
KeywordLength2:
            .db  "as",TokenAs
            .db  "u8",TokenU8
            .db  "i8",TokenI8
            .db  "or",TokenOr
            .db  "if",TokenIf
            .db  "to",TokenTo+$80
KeywordLength3:
            .db  "var",TokenVar
            .db  "u16",TokenU16
            .db  "i16",TokenI16
            .db  "xor",TokenXor
            .db  "mod",TokenMod
            .db  "and",TokenAnd
            .db  "not",TokenNot
            .db  "end",TokenEnd
            .db  "sub",TokenSub
            .db  "for",TokenFor+$80
KeywordLength4:
            .db  "true",TokenTrue
            .db  "fail",TokenFail
            .db  "else",TokenElse
            .db  "step",TokenStep
            .db  "exit",TokenExit+$80
KeywordLength5:
            .db  "false",TokenFalse
            .db  "const",TokenConst
            .db  "fails",TokenFails
            .db  "until",TokenUntil
            .db  "while",TokenWhile+$80
KeywordLength6:
            .db  "assert",TokenAssert
            .db  "return",TokenReturn
            .db  "elseif",TokenElseIf
            .db  "record",TokenRecord
            .db  "string",TokenString
            .db  "handle",TokenHandle+$80
KeywordLength7:
            .db  "boolean",TokenBoolean
            .db  "forward",TokenForward+$80
KeywordLength8:
            .db  "continue",TokenContinue+$80
KeywordCount            .equ 35

PunctuationTable:
            .db  "=",TokenEquals
            .db  ",",TokenComma
            .db  "-",TokenMinus
            .db  "+",TokenPlus
            .db  "*",TokenStar
            ; The final two rows are numeric prefixes. Their positions route
            ; to the based-number scanner and their bytes are digit budgets.
.if AggregateCallSlices
            .db  ".",TokenDot
            .db  "$",5
            .db  "%",17
PunctuationCount        .equ 8
.else
            .db  "$",5
            .db  "%",17
PunctuationCount        .equ 7
.endif

NameMain:               .db "main"
.if LegacyCompilerSlices
NameIndex:              .db "index"
NameBytes:              .db "bytes"
.endif
.if AggregateCallSlices
NameLength:             .db "length"
NameCapacity:           .db "capacity"

; Predefined services and error constants remain ordinary names to the
; tokenizer. The packed table gives the parser one namespace and dispatch
; authority without installing source-visible symbol entries.
Stage8PredefinedTable:
            .db 13
NameReadInputByte:
            .db "readInputByte"
            .db 15
NameWriteOutputByte:
            .db "writeOutputByte"
            .db 15,"readStorageByte"
            .db 18,"rewindStorageInput"
            .db 16,"writeStorageByte"
            .db 17,"seekStorageOutput"
            .db 8,"readPort"
            .db 9,"writePort"
            .db 10,"endOfInput"
            .db 12,"inputFailure"
            .db 13,"outputFailure"
            .db 14,"storageFailure"
Stage8PredefinedCount .equ 12

; Complete service selectors: target ID in bits 0..2, argument type in bits
; 3..4, successful u8 result in bit 5, and service kind in bit 7.
Stage8ServiceSignatureTable:
            .db Stage8CallableServiceFlag+Stage8ServiceResultU8+Stage8ServiceReadInput
            .db Stage8CallableServiceFlag+(ScalarTypeU8*8)+Stage8ServiceWriteOutput
            .db Stage8CallableServiceFlag+Stage8ServiceResultU8+Stage8ServiceReadStorage
            .db Stage8CallableServiceFlag+Stage8ServiceRewindStorage
            .db Stage8CallableServiceFlag+(ScalarTypeU8*8)+Stage8ServiceWriteStorage
            .db Stage8CallableServiceFlag+(ScalarTypeU16*8)+Stage8ServiceSeekStorage
.else
; Earlier proof fixtures retain their deliberately narrower parsers. These
; names are their immutable comparison strings and are not a second service
; namespace in the active packed LL(1) compiler.
NameReadInputByte:      .db "readInputByte"
NameWriteOutputByte:    .db "writeOutputByte"
.endif
.if LegacyCompilerSlices
NameResult:             .db "result"
.endif

; Constant-comparison truth values. Rows follow the dense Comparison* ordinal
; order; columns are equal, less, and greater relations. This is immutable
; language data and contains no compiler address or encoded instruction.
TypedComparisonResults:
            .db 1,0,0
            .db 0,1,1
            .db 0,1,0
            .db 1,1,0
            .db 0,0,1
            .db 1,0,1
