; Fixed compiler state for the scalar-local, counted-loop, and array slice.

CPSTBASE  EQU MMWORK

SSPARTID  EQU CPSTBASE+$00
; The live source position and cursor form one eight-byte snapshot. The
; tokenizer copies the complete full-width record to the token anchor without
; shortening or packing any address or position.
SSOFF     EQU CPSTBASE+$01
SSLINE    EQU CPSTBASE+$03
SSCOL     EQU CPSTBASE+$05
SSCUR     EQU CPSTBASE+$07
SSEND     EQU CPSTBASE+$09
SSLNTOK   EQU CPSTBASE+$0B
SSDELDEP  EQU CPSTBASE+$0C

TNSTOFF   EQU CPSTBASE+$0D
TNSTLINE  EQU CPSTBASE+$0F
TNSTCOL   EQU CPSTBASE+$11
TNLEXPTR  EQU CPSTBASE+$13
TNLEN     EQU CPSTBASE+$15

DGCODE    EQU CPSTBASE+$16
DGPARTID  EQU CPSTBASE+$17
; Diagnostics are terminal and every path that needs an earlier source
; position restores it to the token anchor before raising. The anchor remains
; live through native emission, so the host-visible diagnostic record can
; name those same full-width words without copying or packing them.
DGOFF     EQU TNSTOFF
DGLINE    EQU TNSTLINE
DGCOL     EQU TNSTCOL

; DiagnosticCode and DiagnosticPartId remain clear on successful compilation.
; The semantic sink occupies separate state while the token anchor stays live.
SKCUR     EQU CPSTBASE+$18
SKOPCNT   EQU CPSTBASE+$1A

; Emission begins only after parsing succeeds. Its scratch words therefore
; overlay dead source, token, diagnostic, and sink fields. SourcePartId and
; TokenStartOffset..TokenStartColumn remain intact for an emitter diagnostic.
EMPATCH   EQU CPSTBASE+$03
EMCODST   EQU CPSTBASE+$05
EMLOOP    EQU CPSTBASE+$07
EMEXIT    EQU CPSTBASE+$09
EMFAIL    EQU CPSTBASE+$0B
EMUPEXIT  EQU CPSTBASE+$19
EMCUR     EQU CPSTBASE+$13
EMLIM     EQU CPSTBASE+$15
EMDATFIX  EQU CPSTBASE+$17

CPSTEND   EQU CPSTBASE+$1B
SMBUFBAS  EQU CPSTEND
SMPAYBAS  EQU SMBUFBAS+1
; The leading byte is an operation count and the remaining 511 bytes are a
; bounded variable-width transcript. Word aggregate operands must not make the
; complete Chapter 18 program depend on the retired byte-extent encoding.
SMBUFLIM  EQU SMBUFBAS+$200

; Host-only source-map trace ports. Every instruction that uses these equates
; is conditionally absent unless the target compiler sets DebugHooks to one.
; OUT (n),A exposes the full port as (A << 8) | n; hosts classify the low byte.
DTSOURCE  EQU $D8
DTDECL    EQU $D9
DTPUSH    EQU $DA
DTPOP     EQU $DB
DTROUT    EQU $DC
DTSEMST   EQU $DD
DTSEMEND  EQU $DE
DTIMAGE   EQU $DF

; One retained forward signature is enough for the first routine-call slice.
; The source bytes remain stable, so exact names are retained as pointer/length
; pairs rather than copied into another buffer.
FWNAMPTR  EQU SMBUFLIM+$00
FWNAMLEN  EQU SMBUFLIM+$02
FWPARPTR  EQU SMBUFLIM+$03
FWPARLEN  EQU SMBUFLIM+$05
FWORD     EQU SMBUFLIM+$06
FWDONE    EQU SMBUFLIM+$07
FWPARTYP  EQU SMBUFLIM+$08
FWRESTYP  EQU SMBUFLIM+$09

; The predictive expression path keeps one token of lookahead. Zero denotes an
; empty cell. TokenEof is deliberately uncached, so repeated EOF peeks re-read
; the same stable end position; every nonzero token retains its word payload.
PSLOOK    EQU SMBUFLIM+$0A
PSLOOKV   EQU SMBUFLIM+$0B

; Source bytes remain resident through compilation, so a scalar symbol keeps
; the exact spelling as a pointer and length instead of copying name bytes.
; The entry at SymbolCount is provisional until the declaration initializer
; succeeds; lookup sees only the committed prefix.
SYCNT     EQU SMBUFLIM+$0D
NXLOCAL   EQU SMBUFLIM+$0E
NXPROG    EQU SMBUFLIM+$0F
SYTABBAS  EQU SMBUFLIM+$10
SYENTSZ   EQU 7
SYTYPID   EQU 6
SYCAP     EQU 16
SYTABLIM  EQU SYTABBAS+SYENTSZ*SYCAP

; Expression metadata is deliberately explicit in the correctness build.
; A bounded stack retains the left operand of recursive expression parses;
; each entry is metadata plus a constant value word. The later compression
; pass may overlay this state once its liveness has been measured.
EXEXPTYP  EQU SYTABLIM+$00
EXEMITON  EQU SYTABLIM+$01
EXSUPFLT  EQU SYTABLIM+$02
; These seven bytes are copied into every pending-expression frame as one
; full-width block. The following right-result cells remain outside it because
; they must stay live while the saved left state is restored.
EXSAVE    EQU EXSUPFLT
EXLMETA   EQU SYTABLIM+$03
EXLVAL    EQU SYTABLIM+$04
EXOP      EQU SYTABLIM+$06
EXOPOFF   EQU SYTABLIM+$07
EXSAVESZ  EQU 7
; The saved state and its complete value position form one 13-byte frame copy.
EXVALPOS  EQU SYTABLIM+$09 ; offset, line, column
EXSTKDEP  EQU SYTABLIM+$0F
EXRMETA   EQU SYTABLIM+$10
EXRVAL    EQU SYTABLIM+$11
DCINFO    EQU SYTABLIM+$13
DCPAY     EQU SYTABLIM+$14
DCNAMPTR  EQU SYTABLIM+$16
DCNAMLEN  EQU SYTABLIM+$18
EXCALOFF  EQU SYTABLIM+$19
DCNAMPOS  EQU SYTABLIM+$1B ; offset, line, column
EXLPOSPT  EQU SYTABLIM+$21
EXSTKBAS  EQU SYTABLIM+$23
EXSTKCAP  EQU 16
EXSTKESZ  EQU 13
EXSTKLIM  EQU EXSTKBAS+EXSTKCAP*EXSTKESZ

; Boolean short-circuit emission retains one forward patch per nesting level.
EBFDEP    EQU EXSTKLIM+$00
EBFBAS    EQU EXSTKLIM+$01
EBFCAP    EQU 16
EBFLIM    EQU EBFBAS+EBFCAP*2

; Structured-control parsing and Z80 emission occur in disjoint phases.
; The parser uses bounded ten-byte control frames; after successful parsing the
; Z80 backend reuses the same region for absolute labels and branch fixups.
CTWORK    EQU EBFLIM
CTDEP     EQU CTWORK+$00
CTNXLBL   EQU CTWORK+$01
CTGLBCNT  EQU CTWORK+$02
CRKIND    EQU CTWORK+$03
CTRESTYP  EQU CTWORK+$04
CTFALLS   EQU CTWORK+$05
CFBAS     EQU CTWORK+$08
CFSZ      EQU 10
CFCAP     EQU 8
CFLIM     EQU CFBAS+CFSZ*CFCAP

CKIF      EQU 1
CKWHILE   EQU 2
CKFOR     EQU 3
CKHDL     EQU 4
CKSEL     EQU 5
CRNONE    EQU 0
CRVAL     EQU 1
CRLBL     EQU 31
CFKIND    EQU 0
CFLBLA    EQU 1
CFCONT    EQU 2
CFEXIT    EQU 3
CFCTR     EQU 4
CFMODE    EQU 5
CFSTEP    EQU 6
CFTRPOFF  EQU 8
CTNOCTR   EQU $FF
CTWHTRUE  EQU 1

ECFCNT    EQU CTWORK+$00
%IF TargetStreamingOutput
; Production labels retain validity/bank and the full address together. The
; three-byte record keeps the ordinary 16-bit address while sharing one x3
; address calculation between definition and resolution.
ECLBAS    EQU CTWORK+$01
ECLSZ     EQU 3
ECLVAL    EQU 0
ECLADR    EQU 1
ECLVBAS   EQU ECLBAS
ECLABAS   EQU ECLBAS+ECLADR
%ELSE
ECLVBAS   EQU CTWORK+$01
%ENDIF
ECLCAP    EQU 64
%IF TargetStreamingOutput
ECFBAS    EQU ECLBAS+ECLCAP*ECLSZ
%ELSE
ECLABAS   EQU ECLVBAS+ECLCAP
ECFBAS    EQU ECLABAS+ECLCAP*2
%ENDIF
ECFSZ     EQU 4
ECFCAP    EQU 32
ECFLIM    EQU ECFBAS+ECFSZ*ECFCAP
; Published program metadata must survive source parsing. It therefore cannot
; overlay SourceCursor as the earlier non-atomic slices did.
GNSZ      EQU ECFLIM
%IF SegmentedOutput
; Four target-adapter segments. Each retained entry is base then exclusive
; limit. Code and rodata have published image bytes;
; data and bss describe runtime storage initialized by the generated startup.
GNROSZ    EQU GNSZ+2
GNDATSZ   EQU GNROSZ+2
GNBSSSZ   EQU GNDATSZ+2
PUSZ      EQU GNBSSSZ+2
PUROSZ    EQU PUSZ+2
PUDATSZ   EQU PUROSZ+2
PUBSSSZ   EQU PUDATSZ+2
SGTABBAS  EQU PUBSSSZ+2
SGENTSZ   EQU 4
SGCAP     EQU 4
SGTABLIM  EQU SGTABBAS+SGENTSZ*SGCAP
SGENTBAS  EQU 0
SGENTLIM  EQU 2
SGCODE    EQU 0
SGRODAT   EQU 1
SGDAT     EQU 2
SGBSS     EQU 3
SGCDENT   EQU SGTABBAS+SGENTSZ*SGCODE
SGROENT   EQU SGTABBAS+SGENTSZ*SGRODAT
SGDATENT  EQU SGTABBAS+SGENTSZ*SGDAT
SGBSSENT  EQU SGTABBAS+SGENTSZ*SGBSS
SGROCUR   EQU SGTABLIM ; word
PGBSSLEN  EQU SGROCUR+2 ; word
S5WKEND   EQU PGBSSLEN+2
%ELSE
PUSZ      EQU GNSZ+2
S5WKEND   EQU PUSZ+2
%ENDIF

; Stage 6 retains aggregate type and layout metadata for the complete
; compilation. Type IDs 1..3 are the predefined scalars; IDs 4 and above name
; bounded four-byte descriptors. Record field offsets remain live for the
; later selection stage, while the complete static image survives into Z80
; emission.
AGSTATE   EQU S5WKEND
AGMODE    EQU AGSTATE+$00
ATCNT     EQU AGSTATE+$01
ARCNT     EQU AGSTATE+$02
AFCNT     EQU AGSTATE+$03
AIDEP     EQU AGSTATE+$04
; Nonzero once an explicit initializer has supplied at least one value. The
; value is a Boolean allocation choice, not a retained element count.
AGHASINI  EQU AGSTATE+$05
ACTYPID   EQU AGSTATE+$06
ACFLDST   EQU AGSTATE+$07
ACFLDCNT  EQU AGSTATE+$08
ACRECEXT  EQU AGSTATE+$09 ; word
ACOBJOFF  EQU AGSTATE+$0B ; word
ACOBJEXT  EQU AGSTATE+$0D ; word
ANKIND    EQU AGSTATE+$0F
ANAUX     EQU AGSTATE+$10
ANLEN     EQU AGSTATE+$11 ; word
ANEXT     EQU AGSTATE+$13 ; word
ACOBJEND  EQU AGSTATE+$15 ; word
AGSTEND   EQU AGSTATE+$17

ATTABBAS  EQU AGSTEND
; Every dynamic type is one self-contained six-byte descriptor. The first four
; bytes remain the structural identity used to intern strings and arrays;
; nominal records are always appended. The final word retains the complete
; storage extent without a parallel index.
ATENTSZ   EQU 6
ATCAP     EQU 8
ATTABLIM  EQU ATTABBAS+ATENTSZ*ATCAP
ATKIND    EQU 0
ATAUX     EQU 1
ATLEN     EQU 2 ; word
ATEXT     EQU 4 ; word
; Every dynamic type retains its complete nonzero extent as a word. Strings
; remain byte-capacity values, while arrays and records may occupy the complete
; selected program-data region.
ARCAP     EQU 5
; Record descriptors use Aux as the field-table start and Length low as the
; field count. Length high remains zero. This embeds the old record directory
; without weakening nominal record identity.
ARFLDST   EQU ATAUX
ARFLDCNT  EQU ATLEN

AFTABBAS  EQU ATTABLIM
AFENTSZ   EQU 6
AFCAP     EQU 12
AFTABLIM  EQU AFTABBAS+AFENTSZ*AFCAP
AFNAMPTR  EQU 0
AFNAMLEN  EQU 2
AFTYPID   EQU 3
AFOFF     EQU 4 ; word

IMGLEN    EQU AFTABLIM ; word
%IF SegmentedOutput
ROILEN    EQU IMGLEN+2 ; word
; One complete object is built in scratch. Published rodata keeps initialized
; data first and aggregate-constant bytes in a read-only suffix.
AIBAS     EQU ROILEN+2
AICAP     EQU 1024
IMGBAS    EQU AIBAS+AICAP
IMGCAP    EQU 1024
%ELSE
IMGBAS    EQU IMGLEN+2
AIBAS     EQU IMGBAS
IMGCAP    EQU 255
%ENDIF
IMGLIM    EQU IMGBAS+IMGCAP

; Type suffixes are collected outermost-first before their descriptors are
; interned innermost-first. This buffer is deliberately separate from both the
; initializer scratch image and the accumulated static image because retained
; streaming and non-streaming layouts give those regions different lifetimes.
ADCAP     EQU 4
ADENTSZ   EQU 4 ; length word, source-offset word
ADCNT     EQU IMGLIM
ATOAFLAG  EQU ADCNT+1
ADBAS     EQU ATOAFLAG+1
ADLIM     EQU ADBAS+ADENTSZ*ADCAP
ATRESOFF  EQU ADLIM ; word
ATOAPOS   EQU ATRESOFF+2 ; offset, line, column
ATWKLIM   EQU ATOAPOS+6

AGWKEND   EQU ATWKLIM
CPWKEND   EQU AGWKEND

AIDEPCAP  EQU 4

; Emission follows successful parsing and may overlay the retained forward.
SMRDCUR   EQU FWNAMPTR
EMRTNADR  EQU FWPARPTR
EMRTNCFX  EQU FWPARLEN
EMIFFIX   EQU FWORD

TOKENEOF  EQU 0
TNNL      EQU 1
TNNAME    EQU 2
TNCHAR    EQU 3
TNNUM     EQU 4
TNLPAR    EQU 5
TNRPAR    EQU 6
TNEQ      EQU 7
TOKENSUB  EQU 8
TNFAILS   EQU 9
TOKENOR   EQU 10
TNFAIL    EQU 11
TOKENEND  EQU 12
TOKENVAR  EQU 13
TOKENAS   EQU 14
TOKENU8   EQU 15
TOKENFOR  EQU 16
TNUNT     EQU 17
TNLBRK    EQU 18
TNRBRK    EQU 19
TNCOMMA   EQU 20
TNFWD     EQU 21
TNRET     EQU 22
TOKENIF   EQU 23
TNMIN     EQU 24
TNPLUS    EQU 25
TNSTAR    EQU 26
TOKENU16  EQU 27
TNBOOL    EQU 28
TNTRUE    EQU 29
TNFALSE   EQU 30
TNCONST   EQU 31
TNSLASH   EQU 32
TNLT      EQU 33
TNLTEQ    EQU 34
TNGT      EQU 35
TNGTEQ    EQU 36
TNNOTEQ   EQU 37
TOKENNOT  EQU 38
TOKENAND  EQU 39
TNELSEIF  EQU 40
TNELSE    EQU 41
TNWHILE   EQU 42
TOKENTO   EQU 43
TNSTEP    EQU 44
TNEXIT    EQU 45
TNCONT    EQU 46
TNSTRLIT  EQU 47
TNREC     EQU 48
TNSTR     EQU 49
TOKENDOT  EQU 50
TNHDL     EQU 51
; Ordinal 52 is intentionally unused so later token ordinals remain stable.
TOKENXOR  EQU 53
TOKENMOD  EQU 54
TNASRT    EQU 55
TOKENI8   EQU 56
TOKENI16  EQU 57
TNSEL     EQU 58
TNCASE    EQU 59

DGNONE    EQU 0
DGLEX     EQU 1
DXMAIN    EQU 17
DXWR      EQU 22
DXIDX     EQU 29
DGACTCTR  EQU 36
DXTOPLVL  EQU 37
DXBYTS    EQU 38
DXARRLEN  EQU 39
DGSNKCAP  EQU 40
DGFIXRNG  EQU 41
DXRD      EQU 45
DXVAL     EQU 51
DXRES     EQU 52
DGFWDMIS  EQU 53
DGFWDINC  EQU 54
DGDUPNAM  EQU 55
DGSYMCAP  EQU 56
DGUNKNAM  EQU 57
DXSCA     EQU 58
DXTYP     EQU 59
DGTYPMIS  EQU 60
DGINTRNG  EQU 61
DGDIVZER  EQU 62
DGNAR     EQU 63
DGCMPCHN  EQU 64
DGEXPCAP  EQU 65
DGBFXCAP  EQU 66
DGINTOP   EQU 67
DGCTLCAP  EQU 68
DGCLBCAP  EQU 69
DGCFXCAP  EQU 70
DXBOOL    EQU 71
DXLOOP    EQU 72
DGLOPCTR  EQU 73
DGLOPSTP  EQU 74
DGRTNFLW  EQU 75
DGTYPCAP  EQU 76
DGINICAP  EQU 77
DGINISHP  EQU 78
DGINICNT  EQU 79
DGSTRLEN  EQU 80
DGPDCAP   EQU 81
; Bounded string capacity is at most 253; use u8[N] plus a scalar length for
; an unterminated, caller-managed buffer.
DGSTRCAP  EQU 90
DGASSERT  EQU 91
DGOUTSEG  EQU 92
DGROCAP   EQU 93
DGROASGN  EQU 94
; Target diagnostics occupy 95..97 in target-output-state.asmi. Append the
; same-line handler diagnostic without changing any published ordinal.
DGHDLINE  EQU 98
DXCASE    EQU 99
DGSELCLS  EQU 100
DGSPCAP   EQU 101
DGRECEMP  EQU 82
DGTYPBND  EQU 83

; Ordinary token mismatches encode the token ordinal directly. Named-value
; mismatches retain their context-specific diagnostic codes above.
DXTOKBAS  EQU $80
DXEOF     EQU DXTOKBAS+TOKENEOF
DXNAME    EQU DXTOKBAS+TNNAME
DXLINE    EQU DXTOKBAS+TNNL
DXCHAR    EQU DXTOKBAS+TNCHAR
DXNUM     EQU DXTOKBAS+TNNUM
DXLPAR    EQU DXTOKBAS+TNLPAR
DXRPAR    EQU DXTOKBAS+TNRPAR
DXEQ      EQU DXTOKBAS+TNEQ
DXSUB     EQU DXTOKBAS+TOKENSUB
DXFAILS   EQU DXTOKBAS+TNFAILS
DXOR      EQU DXTOKBAS+TOKENOR
DXFAIL    EQU DXTOKBAS+TNFAIL
DXEND     EQU DXTOKBAS+TOKENEND
DXVAR     EQU DXTOKBAS+TOKENVAR
DXAS      EQU DXTOKBAS+TOKENAS
DXU8      EQU DXTOKBAS+TOKENU8
DXFOR     EQU DXTOKBAS+TOKENFOR
DXUNT     EQU DXTOKBAS+TNUNT
DXLBRK    EQU DXTOKBAS+TNLBRK
DXRBRK    EQU DXTOKBAS+TNRBRK
DXCOMMA   EQU DXTOKBAS+TNCOMMA
DXFWD     EQU DXTOKBAS+TNFWD
DXRET     EQU DXTOKBAS+TNRET
DXIF      EQU DXTOKBAS+TOKENIF
DXMIN     EQU DXTOKBAS+TNMIN
DXPLUS    EQU DXTOKBAS+TNPLUS
DXSTAR    EQU DXTOKBAS+TNSTAR
DXSTRLIT  EQU DXTOKBAS+TNSTRLIT

TYEXACT   EQU 0
TYU8      EQU 1
TYU16     EQU 2
TYBOOL    EQU $10
TYI8      EQU $11
TYI16     EQU $12
TYBASMSK  EQU $03
TYSGNFLG  EQU $10
MTTYPMSK  EQU $13
MTNEG     EQU $20
MTCONST   EQU $80
SCCONST   EQU $00
SCPROG    EQU $04
SCLOC     EQU $08
SCPAR     EQU $0C
SCMSK     EQU $0C
SYRECTYP  EQU $40
SYAGGFLG  EQU $80
SIRECTYP  EQU SYRECTYP
SIAGPROG  EQU SYAGGFLG+SCPROG

ATIDU8    EQU TYU8
ATIDU16   EQU TYU16
ATIDBOOL  EQU TYBOOL
ATIDI8    EQU TYI8
ATIDI16   EQU TYI16
AGDYNTYP  EQU $40
ATKREC    EQU 4
ATKSTR    EQU 5
ATKARRAY  EQU 6
; Parameter-only open bounded-string view. It is never interned in the
; aggregate type table and therefore remains outside its compact ordinals.
AGOSTR    EQU $7C
; Parameter-only open arrays encode the exact element type in the low seven
; bits. Live element type IDs occupy 1..11, so this contextual family cannot
; collide with scalar, interned aggregate, or open-string identities.
AGOAMSK   EQU $80
AGOAELEM  EQU $7F
AGOVIEW   EQU AGOSTR

SICU8     EQU SCCONST+TYU8
SICU16    EQU SCCONST+TYU16
SICBOOL   EQU SCCONST+TYBOOL
SICI8     EQU SCCONST+TYI8
SICI16    EQU SCCONST+TYI16
SIPU8     EQU SCPROG+TYU8
SIPU16    EQU SCPROG+TYU16
SIPBOOL   EQU SCPROG+TYBOOL
SIPI8     EQU SCPROG+TYI8
SIPI16    EQU SCPROG+TYI16
SILU8     EQU SCLOC+TYU8
SILU16    EQU SCLOC+TYU16
SILBOOL   EQU SCLOC+TYBOOL
SILI8     EQU SCLOC+TYI8
SILI16    EQU SCLOC+TYI16

SMDECLU8  EQU 1
SMFORU8   EQU 2
SMWROBYT  EQU 3
SMPROP    EQU 4
SMENDLP   EQU 5
SMRET     EQU 6
SMARRU8   EQU 7
SMRDIBYT  EQU 8
SMSTRSU8  EQU 9
SMLDAU8   EQU 10
SMWROU8   EQU 11
SMCLITU8  EQU 12
SMWRLU8   EQU 13
SMFWDU8   EQU 14
SMIFPARZ  EQU 15
SMRETPAR  EQU 16
SMENDIF   EQU 17
SMRTSELF  EQU 18
SMENDRTN  EQU 19
SMDEFPU8  EQU 20
SMBGMAIN  EQU 21
SMDLCLU8  EQU 22
SMLITU8   EQU 23
SMLDPU8   EQU 24
SMLDLU8   EQU 25
SMMULU8   EQU 26
SMADDU8   EQU 27
SMSTPU8   EQU 28
SMSTLU8   EQU 29
SMWRVU8   EQU 30
SMENMAIN  EQU 31
SMDEFP16  EQU 32
SMDECL16  EQU 33
SMLIT16   EQU 34
SMLDP16   EQU 35
SMLDL16   EQU 36
SMADD8    EQU 37
SMADD16   EQU 38
SMSUB8    EQU 39
SMSUB16   EQU 40
SMMUL8    EQU 41
SMMUL16   EQU 42
SMDIV8    EQU 43
SMDIV16   EQU 44
SMNEG8    EQU 45
SMNEG16   EQU 46
SMNOT8    EQU 47
SMNOT16   EQU 48
SMNOTBL   EQU 49
SMAND8    EQU 50
SMAND16   EQU 51
SMOR8     EQU 52
SMOR16    EQU 53
SMXOR8    EQU 54
SMXOR16   EQU 55
SMMOD8    EQU 56
SMMOD16   EQU 57
SMCMP8    EQU 58
SMCMP16   EQU 59
SMCMPBL   EQU 60
SMNARU8   EQU 61
SMSTP16   EQU 62
SMSTL16   EQU 63
SMBGAND   EQU 64
SMBGOR    EQU 65
SMENDBL   EQU 66
SMCTLLBL  EQU 67
SMBRFALS  EQU 68
SMJUMP    EQU 69
SMFORSET  EQU 70
SMFTEST   EQU 71
SMFNEXT   EQU 72
SMFCLEAN  EQU 73
SMBEGRTN  EQU 74
SMLDPAR8  EQU 75
SMLDPA16  EQU 76
SMCALLSC  EQU 77
SMRETSCA  EQU 78
SMSTPAR8  EQU 79
SMSTPA16  EQU 80
SMENTRTN  EQU 81
; Production-only extensions retain global ordinals so every historical
; conditional layout can still assemble the shared expression parser.
SMCVTINT  EQU 116
SMDIVSGN  EQU 117
SMPRI8    EQU 118
SMRDPRTD  EQU 119
SMRDPORT  EQU 120
SMWRPORT  EQU 121
SMPKTSVC  EQU 122
SMSELCS   EQU 123

RCEQ      EQU 0
RCNE      EQU 1
RCLT      EQU 2
RCLE      EQU 3
RCGT      EQU 4
RCGE      EQU 5
