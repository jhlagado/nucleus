; Workspace and ABI constants for the standalone NOBJ 0.1 consumer.
;
; The including deployment supplies:
;   NobjConsumerWorkspaceBase
;   NobjConsumerPlatformBase
;   NobjConsumerPlatformCodeBase / NobjConsumerPlatformCodeLimit
;   NobjConsumerCodeBase / NobjConsumerCodeLimit
;   NobjConsumerStackBase / NobjConsumerStackLimit
;   NobjConsumerObjectBase / NobjConsumerObjectLimit
;   NobjConsumerControlBase / NobjConsumerControlLimit
;
; The protected extents are half-open. A zero base and zero limit disable
; the object extent for a binding whose object is not memory mapped.

LVKBEGIN   EQU 1
LVKIMAGE   EQU 2
LVKPATCH   EQU 3
LVKMAP     EQU 4
LVKCOMIT   EQU 5

LVPBEGIN   EQU 0
LVPIMAGE   EQU 1
LVPPATCH   EQU 2
LVPMAP     EQU 3
LVPCOMIT   EQU 4

LVOPROOF   EQU 0
LVOINVAL   EQU 1
LVOPLAT    EQU 2

LVSDESC    EQU 1
LVSVECT    EQU 2
LVSDEPLY   EQU 3
LVSTRUNC   EQU 4
LVSFRAME   EQU 5
LVSORDER   EQU 6
LVSTGEXT   EQU 7
LVSIMORD   EQU 8
LVSRSV9    EQU 9
LVSMAP     EQU 10
LVSCOMIT   EQU 11
LVSCRC     EQU 12
LVSTRAIL   EQU 13
LVSRSV14   EQU 14
LVSPROT    EQU 15

LVPLEND    EQU 1

LVVECSZ    EQU 32
LVMAPCAP   EQU 325

; Platform vector entries after the eight-byte NC header.
LVOPEN     EQU LVPLBASE+8
LVREAD     EQU LVPLBASE+11
LVREWIND   EQU LVPLBASE+14
LVLOCK     EQU LVPLBASE+17
LVSELECT   EQU LVPLBASE+20
LVPUBL     EQU LVPLBASE+23
LVENTER    EQU LVPLBASE+26
LVCLOSE    EQU LVPLBASE+29

LVSDPTR    EQU LVWKBASE
LVSPPTR    EQU LVSDPTR+2
LVSRPTR    EQU LVSPPTR+2
LVRECNO    EQU LVSRPTR+2
LVCRC      EQU LVRECNO+2
LVPLEN     EQU LVCRC+2
LVIMBASE   EQU LVPLEN+2
LVIMCAP    EQU LVIMBASE+2
LVWRBASE   EQU LVIMCAP+2
LVWRCAP    EQU LVWRBASE+2
LVCURADR   EQU LVWRCAP+2
LVCUREND   EQU LVCURADR+2
LVMAPLEN   EQU LVCUREND+2
LVRECKND   EQU LVMAPLEN+2
LVPHASE    EQU LVRECKND+1
LVROM      EQU LVPHASE+1
LVBGFLAG   EQU LVROM+1
LVPRFLAG   EQU LVBGFLAG+1
LVRTID     EQU LVPRFLAG+1
LVBKCNT    EQU LVRTID+2
LVFILL     EQU LVBKCNT+1
LVENTBNK   EQU LVFILL+1
LVIMSEEN   EQU LVENTBNK+1
LVCURBNK   EQU LVIMSEEN+1
LVFLOUT    EQU LVCURBNK+1
LVFLSTAT   EQU LVFLOUT+1
LVIMENDS   EQU LVFLSTAT+1 ; four u16 ends
LVPATEND   EQU LVIMENDS+8      ; four u16 ends
LVMAPBUF   EQU LVPATEND+8
LVWKEND    EQU LVMAPBUF+LVMAPCAP

LVMFLAGS   EQU 1
LVMENTBK   EQU 2
LVMENTRY   EQU 3
LVMWRBAS   EQU 5
LVMWRCAP   EQU 7
LVMVBASE   EQU 9
LVMVLEN    EQU 11
LVMIBASE   EQU 13
LVMILEN    EQU 15
LVMBBASE   EQU 17
LVMBLEN    EQU 19
LVMSTACK   EQU 21
LVMDLBNK   EQU 23
LVMDLADR   EQU 24
LVMDLLEN   EQU 26
LVMPARTS   EQU 28
