; Zero-byte aliases resolved after the typed and aggregate-call templates.
; Included only with AggregateCallSlices, alongside aggregate-call-z80.asm.
ZARETAG    EQU ZXRETURN
ZALDPAL    EQU ZXLDLC16
ZAIDXTOA   EQU ZXLDSPPF+1
ZALDI8B    EQU ZXIND8PF
ZACPYPRE   EQU ZXPOPOB
ZAPSHHLD   EQU ZXPOPOB+2
ZAZERHB    EQU ZXZEROH
ZALDIR     EQU ZXSEGCOP
ZADECSP    EQU ZXPAR16B
ZALDIXL    EQU ZXLDLO
ZALDIXH    EQU ZXLDHI
ZASTIXL    EQU ZXSTLO
ZASTIXH    EQU ZXSTHI
ZAADDEPS   EQU ZAOFFSET+3
ZAPIDXBS   EQU ZXPOPOB
ZASTI8B    EQU ZASTI16B
ZAPERRB    EQU ZXNOT8B ; POP HL / LD A,L prefix
ZAERRCRB   EQU ZXATOHL       ; LD L,A / LD H,0 / PUSH HL
