extern LVOPEN
in HL
out A,carry,zero
clobbers B,C,D,E,H,L,sign,parity,halfCarry
preserves IX,IY
end

extern LVREAD
out A,carry,zero
clobbers sign,parity,halfCarry
preserves BC,DE,HL,IX,IY
end

extern LVREWIND
out A,carry,zero
clobbers B,C,D,E,H,L,sign,parity,halfCarry
preserves IX,IY
end

extern LVLOCK
out A,D,E,H,L,carry,zero
clobbers B,C,sign,parity,halfCarry
preserves IX,IY
end

extern LVSELECT
in A,IX
out A,carry,zero
clobbers B,C,D,E,H,L,sign,parity,halfCarry
preserves IX,IY
end

extern LVPUBL
in A,BC,DE,HL,IX
out A,carry,zero
clobbers B,C,D,E,H,L,IXH,IXL,sign,parity,halfCarry
preserves IY
end

extern LVENTER
in A,HL,IX
out A,carry,zero
clobbers B,C,D,E,H,L,IXH,IXL,sign,parity,halfCarry
preserves IY
end

extern LVCLOSE
out A,carry,zero
clobbers B,C,D,E,H,L,sign,parity,halfCarry
preserves IX,IY
end
