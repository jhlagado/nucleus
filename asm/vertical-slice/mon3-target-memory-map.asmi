; Native compiler deployment for a TEC-1G-style machine with MON3 fixed ROM.
; The compiler occupies the 8000h-BFFFh expansion window, leaving the low RST
; vectors and C000h-FFFFh monitor ROM untouched. Target output is streamed and
; is not materialized over the compiler while compilation is active.

MMCORE     EQU $8000
MMCORLIM   EQU $C000

MMWORK     EQU $6000
MMWRKLIM   EQU $7000
MMSOURCE   EQU $7000
MMSRCLIM   EQU $7800
MMTOKEN    EQU MMSOURCE
MMTOKEND   EQU MMSOURCE+$0500
SRCCHUNK   EQU MMTOKEND
MMCHKEND   EQU MMSRCLIM

MMRGEN     EQU MMSRCLIM
MMRGNEND   EQU MMSRCLIM
MMCORP     EQU $7800
MMCORPEN   EQU $7B00
MMRUN      EQU $7B00
MMRUNEND   EQU $7C00
MMEXEC     EQU $7C00
MMEXEND    EQU $7D00
MMDATA     EQU MMEXEC
MMDATEND   EQU MMEXEC
MMBSS      EQU MMEXEC
MMBSSEND   EQU MMEXEC
MMREGEND   EQU MMEXEC
MMREGCAP   EQU 0
RORDCAP    EQU $0400
MMSERV     EQU $7D00
MMSRVEND   EQU $7E00
MMPROOF    EQU $7E00
MMPREND    EQU $7E00
MMSPARE    EQU $7E00
MMRBACK    EQU $7E00
MMRBKEND   EQU $7E00
MMSPEND    EQU $7E00

MMSTKBOT   EQU $7E00
STACKTOP   EQU $7F00
MMHIGH     EQU $C000
; Highest address is a native word; host output reports its exclusive end +1.
MMLAST     EQU $FFFF

MMHOSTTD   EQU $5900
MMRETPC    EQU $5FFF
