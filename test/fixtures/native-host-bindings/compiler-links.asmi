; Five test-only links into the separately built compiler. The qualification
; test checks each address against both the frozen and current shipped image.
; This file does not substitute compiler state or implement compiler routines.
%IF Mon3HostTransport
SAPRTERR  EQU $801B
SAINIT    EQU $8000
DGCOPYP   EQU $83FC
DGINLINE  EQU $83F5
%IF DebugHooks
CTACPART  EQU $9281
%ELSE
CTACPART  EQU $927D
%ENDIF
%ELSE
SAPRTERR  EQU $001B
SAINIT    EQU $0000
DGCOPYP   EQU $03FC
DGINLINE  EQU $03F5
%IF DebugHooks
CTACPART  EQU $1281
%ELSE
CTACPART  EQU $127D
%ENDIF
%ENDIF
