; Five test-only links into the separately built compiler. The qualification
; test checks each address against both the frozen and current shipped image.
; This file does not substitute compiler state or implement compiler routines.
%IF Mon3HostTransport
SAPRTERR  EQU $801B
SAINIT    EQU $8000
DGCOPYP   EQU $8423
DGINLINE  EQU $841C
%IF DebugHooks
CTACPART  EQU $92A8
%ELSE
CTACPART  EQU $92A4
%ENDIF
%ELSE
SAPRTERR  EQU $001B
SAINIT    EQU $0000
DGCOPYP   EQU $0423
DGINLINE  EQU $041C
%IF DebugHooks
CTACPART  EQU $12A8
%ELSE
CTACPART  EQU $12A4
%ENDIF
%ENDIF
