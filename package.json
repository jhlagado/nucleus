{
  "name": "@jhlagado/nucleus",
  "version": "0.3.0",
  "description": "Nucleus: a small typed language with a direct compiler for 16K Z80 systems",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhlagado/nucleus.git"
  },
  "bugs": {
    "url": "https://github.com/jhlagado/nucleus/issues"
  },
  "homepage": "https://debug80.com/nucleus/",
  "type": "module",
  "bin": {
    "nucleus": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./compiler": "./dist/compiler.js",
    "./configuration": "./dist/configuration.js",
    "./d8": "./dist/d8.js",
    "./host": "./dist/host.js",
    "./nobj": "./dist/nobj.js",
    "./nobj-file": "./dist/nobj-file.js",
    "./object-services": "./dist/object-services.js",
    "./project-host": "./dist/project-host.js",
    "./publication": "./dist/publication.js",
    "./runtime-catalog": "./dist/runtime-catalog.js",
    "./runtime-catalog-services": "./dist/runtime-catalog-services.js",
    "./runner": "./dist/runner.js"
  },
  "files": [
    "asm/",
    "dist/",
    "docs/",
    "grammar/",
    "library/",
    "README.md"
  ],
  "scripts": {
    "check:azm-toolchain": "node scripts/check-azm-toolchain.mjs",
    "check:compiler-relocation": "vitest run test/compiler-relocation.test.ts --reporter=verbose",
    "check:runtime-boundary": "node scripts/check-runtime-boundary.mjs",
    "generate:compiler-images": "node scripts/generate-compiler-images.mjs",
    "check:compiler-images": "node scripts/generate-compiler-images.mjs --check",
    "prebuild": "npm run generate:compiler-images",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test --maxWorkers=1",
    "measure": "vitest run test/proof-harness.test.ts --reporter=verbose",
    "proof": "vitest run test/proof-harness.test.ts --reporter=verbose",
    "prepublishOnly": "npm run check:compiler-images && npm run typecheck && npm test && npm run build && npm run check:runtime-boundary"
  },
  "dependencies": {
    "@jhlagado/debug80-runtime": "git+https://github.com/jhlagado/debug80-runtime.git#b7343aa8c38c248abbc6ee801b4af270d4843ad6"
  },
  "devDependencies": {
    "@jhlagado/azm": "^0.3.9",
    "@types/node": "^20.10.0",
    "typescript": "5.3.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
