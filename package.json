{
  "name": "@jhlagado/nucleus",
  "version": "0.1.0",
  "description": "Nucleus: a small typed language with a direct compiler for 16K Z80 systems",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhlagado/nucleus.git"
  },
  "bugs": {
    "url": "https://github.com/jhlagado/nucleus/issues"
  },
  "homepage": "https://debug80.com/nucleus/",
  "type": "module",
  "bin": {
    "nucleus": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./compiler": "./dist/compiler.js",
    "./nobj": "./dist/nobj.js"
  },
  "files": [
    "asm/",
    "dist/",
    "docs/",
    "grammar/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test",
    "measure": "vitest run test/proof-harness.test.ts --reporter=verbose",
    "proof": "vitest run test/proof-harness.test.ts --reporter=verbose",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@jhlagado/azm": "^0.3.9"
  },
  "peerDependencies": {
    "@jhlagado/debug80-runtime": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "5.3.3",
    "vitest": "^4.1.7"
  }
}
